---
import {
  PERSPECTIVES,
  gridFor,
  gridHref,
  type Grid,
} from "../printables/perspective-grid/perspective-grid.ts";

interface Props {
  /** The grid currently being shown. */
  grid: Grid;
}

const { grid } = Astro.props;

// Two rows of links between pre-rendered pages. The first picks the kind of
// perspective, landing on its first layout; the second picks among the layouts
// of the current kind, since each kind has its own.
const perspectiveOptions = PERSPECTIVES.map((perspective) => ({
  label: perspective.name,
  title: perspective.description,
  href: gridHref(gridFor(perspective.slug, perspective.variants[0].slug)),
  current: perspective.slug === grid.perspective.slug,
}));

const variantOptions = grid.perspective.variants.map((variant) => ({
  label: variant.name,
  title: variant.description,
  href: gridHref(gridFor(grid.perspective.slug, variant.slug)),
  current: variant.slug === grid.variant.slug,
}));
---

<div class="grid-picker no-print">
  {
    [
      { legend: "Type", options: perspectiveOptions },
      { legend: "Layout", options: variantOptions },
    ].map((row) => (
      <div class="row">
        <span class="legend">{row.legend}</span>
        {row.options.map((option) =>
          option.current ? (
            <span class="option current" aria-current="page">
              {option.label}
            </span>
          ) : (
            <a class="option" href={option.href} title={option.title}>
              {option.label}
            </a>
          ),
        )}
      </div>
    ))
  }

  <button type="button" class="print-button">Print</button>
</div>

<script>
  // The only script these pages need: printing has no declarative equivalent.
  for (const button of document.querySelectorAll(".print-button")) {
    button.addEventListener("click", () => window.print());
  }
</script>

<style>
  .grid-picker {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .legend {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    /* Fixed width so both rows of options start on the same left edge. */
    width: 4rem;
  }

  .option,
  .print-button {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    line-height: 1;
    text-decoration: none;
  }

  .current {
    background: var(--bg);
    border-color: var(--accent);
    color: var(--accent);
  }

  .print-button {
    cursor: pointer;
    font: inherit;
    margin-top: 0.25rem;
  }

  a.option:hover,
  .print-button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
