---
// A ruled table with headed columns: an expense log, a list of key dates.
// Columns with a width are that wide; the rest share what is left.
interface Column {
  label: string;
  /** Width in `em`. Omit to share the width the other columns leave. */
  width?: number;
}

interface Props {
  columns: Column[];
  /** Rows; ignored when `labels` is given. */
  rows?: number;
  /** Printed in the first column, one row per label: the days of a month. */
  labels?: string[];
  /** Give each row a set height rather than sharing what is left on the page. */
  fixed?: boolean;
}

const { columns, rows = 0, labels, fixed = false } = Astro.props;
const template = columns
  .map((column) => (column.width ? `${column.width}em` : "1fr"))
  .join(" ");
const rowList = labels ?? Array.from({ length: rows }, () => "");
---

<div class:list={["ledger", { fixed }]} style={`grid-template-columns: ${template};`}>
  {
    columns.map((column, i) => (
      <span class:list={["head", { first: i === 0 }]}>{column.label}</span>
    ))
  }
  {
    rowList.map((label) => (
      <>
        {columns.map((_, i) => (
          <span class:list={["cell", { first: i === 0 }]}>
            {i === 0 && label && <span class="row-label">{label}</span>}
          </span>
        ))}
      </>
    ))
  }
</div>

<style>
  .ledger {
    flex: 1;
    display: grid;
    grid-template-rows: auto;
    grid-auto-rows: minmax(0, 1fr);
    min-height: 0;
  }

  .ledger.fixed {
    flex: none;
    grid-auto-rows: 2.4em;
  }

  .head,
  .cell {
    padding-left: 0.3em;
  }

  .head {
    padding-bottom: 0.2em;
    color: var(--muted);
    border-bottom: 0.08em solid var(--text);
  }

  .cell {
    border-bottom: 0.06em solid var(--muted);
  }

  /* A printed label sits low in its cell, where the writing beside it goes. */
  .cell.first {
    display: flex;
    align-items: flex-end;
  }

  .row-label {
    padding-bottom: 0.1em;
    font-size: 0.8em;
    color: var(--muted);
  }

  /* A rule between columns, but not before the first. */
  .head:not(.first),
  .cell:not(.first) {
    border-left: 0.06em solid var(--muted);
  }
</style>
