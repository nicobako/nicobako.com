---
// A day's schedule: a ruled line per hour with the hour beside it, and a faint
// dotted line at each half hour. The hours share whatever height is left.
interface Props {
  /** First hour, on the 24-hour clock. */
  from: number;
  /** Last hour; it gets a row of its own. */
  to: number;
}

const { from, to } = Astro.props;
const hours = Array.from({ length: to - from + 1 }, (_, i) => from + i);
---

<div class="hours">
  {
    hours.map((hour) => (
      <span class="hour">
        <span class="time">{hour}</span>
        <span class="half" />
      </span>
    ))
  }
</div>

<style>
  .hours {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-top: 0.06em solid var(--muted);
  }

  .hour {
    flex: 1;
    position: relative;
    border-bottom: 0.06em solid var(--muted);
  }

  .time {
    position: absolute;
    top: 0.1em;
    left: 0;
    width: 1.4em;
    font-size: 0.8em;
    text-align: right;
    color: var(--muted);
  }

  /* The half-hour line starts after the hour, so the numbers stand clear. */
  .half {
    position: absolute;
    top: 50%;
    left: 1.8em;
    right: 0;
    border-top: 0.06em dotted var(--muted);
  }
</style>
