---
import Layout from "../../layouts/Layout.astro";
import YearGrid from "../../components/YearGrid.astro";
import YearPicker from "../../components/YearPicker.astro";
import { BUILD_YEAR } from "../../printables/calendar/years.ts";

// The bare path shows the build year; every other year has its own page under
// `year-calendar/[year]`, reached through the picker's links.
const basePath = "/printables/year-calendar";
---

<Layout title="Year Calendar — Nico Bako">
  <div class="controls no-print">
    <h1>Year Calendar</h1>
    <YearPicker year={BUILD_YEAR} basePath={basePath} />
    <p>Monday-first, twelve-month grid. Fits one landscape page.</p>
  </div>

  <YearGrid year={BUILD_YEAR} />
</Layout>

<style>
  .controls {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  @page {
    size: A4 landscape;
    margin: 1cm;
  }
</style>
