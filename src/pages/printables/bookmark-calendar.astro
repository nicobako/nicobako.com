---
import Layout from "../../layouts/Layout.astro";
import BookmarkSheet from "../../components/BookmarkSheet.astro";
import { BUILD_YEAR } from "../../printables/calendar/years.ts";

// The bare path shows the build year; every other year has its own page under
// `bookmark-calendar/[year]`, reached through the picker's links.
const basePath = "/printables/bookmark-calendar";
---

<Layout title="Bookmark Calendar — Nico Bako">
  <BookmarkSheet year={BUILD_YEAR} basePath={basePath} />
</Layout>

<style>
  @page {
    size: A4 landscape;
    margin: 0.5cm;
  }
</style>
