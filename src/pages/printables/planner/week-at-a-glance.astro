---
// The whole week on one sheet, for planning a week at a time: the time of day
// against the days on the left page, the week's tasks and habits on the right.
//
// It is written to be filled in with short codes rather than sentences — the
// index sheet is where a code is given its meaning — so the cells are small
// and many rather than few and roomy. A day's column is about a centimetre and
// a half wide on A5: room for an abbreviation, not for a word.
//
// Every table on the sheet has the same seven day columns, Monday-first like
// every other week on the site, so a day is one column wherever it appears.
// On the left page the two tables share their first column too, which is what
// lines the glance up over the schedule: a day reads straight down the page.
//
// Undated, like the rest of the binder: the hours are the same every week, so
// they are printed; the week itself is a rule you write on.
import Layout from "../../../layouts/Layout.astro";
import PlannerSpread from "../../../components/PlannerSpread.astro";
import Page from "../../../components/paper/Page.astro";
import Heading from "../../../components/paper/Heading.astro";
import Block from "../../../components/paper/Block.astro";
import Rules from "../../../components/paper/Rules.astro";
import Table, { type PaperColumn } from "../../../components/paper/Table.astro";
import { WEEKDAY_SHORT } from "../../../printables/calendar/calendar.ts";

/** One column per day, the same on every table on the sheet. */
const days = (width: number): PaperColumn[] =>
  WEEKDAY_SHORT.map((day) => ({ label: day, width, centre: true }));

// The left page. The first column is the hour on the schedule and blank on
// the glance above it; the same width on both is what keeps the day columns
// in line down the page.
const TIME_WIDTH = 1;
const DAY_WIDTH = 2;
const glance: PaperColumn[] = [
  { label: "", width: TIME_WIDTH },
  ...days(DAY_WIDTH),
];
const schedule: PaperColumn[] = [
  { label: "", width: TIME_WIDTH, centre: true },
  ...days(DAY_WIDTH),
];
/** Lines a day gets at the top of the page, for what the day is about. */
const GLANCE_ROWS = 3;
/** The waking day, one row an hour, printed in 24-hour time. */
const FIRST_HOUR = 6;
const LAST_HOUR = 22;
/** Smallest row height on the left page, in `em`: room for a code. */
const ROW_HEIGHT = 1.3;
const hours = Array.from(
  { length: LAST_HOUR - FIRST_HOUR + 1 },
  (_, i) => String(FIRST_HOUR + i),
);

// The right page. A habit is ticked once a day, so its day columns are narrow
// and the name gets the rest.
const habits: PaperColumn[] = [{ label: "Habit", width: 5 }, ...days(1)];
const HABIT_ROWS = 7;
/** Task lines in each of the two columns. */
const TASK_LINES = 13;
---

<Layout title="Week at a Glance — Nico Bako">
  <h1 class="no-print">Week at a Glance</h1>
  <PlannerSpread>
    <Page slot="left" gap={0.9}>
      <Heading text="Week" dated />
      {/* The two blocks share the page by `grow`, and each pays for its own
          heading and column labels out of its share — so the glance asks for
          one row more than it has, which is what brings a glance row out the
          same height as an hour. Look at the sheet on screen after changing
          either count. */}
      <Block label="At a glance" grow={GLANCE_ROWS + 1}>
        <Table columns={glance} rows={GLANCE_ROWS} minHeight={ROW_HEIGHT} />
      </Block>
      <Block label="Schedule" grow={hours.length}>
        <Table columns={schedule} rowLabels={hours} minHeight={ROW_HEIGHT} />
      </Block>
    </Page>

    <Page slot="right" gap={0.9}>
      <Heading text="Week" dated />
      {/* Two columns of tasks rather than one long one: a task written as a
          code is a few letters, and a full-width line would be mostly blank. */}
      <Block label="Tasks" grow={TASK_LINES}>
        <div class="columns">
          <Rules lines={TASK_LINES} marker="box" />
          <Rules lines={TASK_LINES} marker="box" />
        </div>
      </Block>
      <Block label="Habits" grow={HABIT_ROWS}>
        <Table columns={habits} rows={HABIT_ROWS} />
      </Block>
    </Page>
  </PlannerSpread>
</Layout>

<style>
  /* Side by side, each taking half the width and all of the block's height;
     each `Rules` is `flex: 1`, which in a row means width. */
  .columns {
    flex: 1;
    display: flex;
    gap: 1.2em;
    min-height: 0;
  }
</style>
