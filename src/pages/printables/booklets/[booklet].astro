---
import Layout from "../../../layouts/Layout.astro";
import MiniZine from "../../../components/MiniZine.astro";
import {
  BOOKLETS,
  type Booklet,
} from "../../../printables/booklet/booklets.ts";

export function getStaticPaths() {
  return BOOKLETS.map((booklet) => ({
    params: { booklet: booklet.slug },
    props: { booklet },
  }));
}

interface Props {
  booklet: Booklet;
}

const { booklet } = Astro.props;
---

<Layout title={`${booklet.name} — Nico Bako`} description={booklet.description}>
  <div class="controls no-print">
    <h1>{booklet.name}</h1>
    <p>
      {booklet.description} Eight pages from one sheet of US Letter, printed on
      one side and folded into a mini zine — one cut, no staples. Print at actual
      size (100%), landscape, with no margins.
    </p>
    <ol class="steps">
      <li>
        Fold the sheet in half, then in half again, then once more, so it is
        creased into eight panels.
      </li>
      <li>
        Fold it in half side to side. From the folded edge, cut along the middle
        crease as far as the next crease — the solid line.
      </li>
      <li>
        Unfold it, then fold it in half the long way with the printing outside.
        Push the two ends towards each other so the cut opens into a diamond,
        and keep pushing until it folds flat.
      </li>
      <li>Wrap the pages round so the front cover is on top.</li>
    </ol>
  </div>

  <MiniZine booklet={booklet} />
</Layout>

<style>
  .controls {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .controls p,
  .steps {
    margin: 0;
  }

  .steps {
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
</style>
