---
import Layout from "../../layouts/Layout.astro";
import LinkList, { type LinkListItem } from "../../components/LinkList.astro";

const pages: LinkListItem[] = [
  { label: "Bookmark Calendar", href: "/printables/bookmark-calendar" },
  { label: "Sketchbook", href: "/printables/sketchbook" },
];
---

<Layout title="Printables — Nico Bako">
  <h1 id="printables">Printables</h1>
  <LinkList links={pages} labelledby="printables" />
</Layout>
