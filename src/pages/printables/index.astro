---
import Layout from "../../layouts/Layout.astro";
import { BOOKLET_GROUPS } from "../../printables/booklet/booklets.ts";
---

<Layout title="Printables — Nico Bako">
  <h1>Printables</h1>
  <p>Print-friendly layouts, tables, and calendars. Pick a year, then print.</p>
  <ul>
    <li><a href="/printables/year-calendar">Year Calendar</a></li>
    <li><a href="/printables/bookmark-calendar">Bookmark Calendar</a></li>
    <li>
      <a href="/printables/weekly-practice-schedule"
        >Weekly Practice Schedule</a>
    </li>
    <li>
      <a href="/printables/daily-practice-schedule">Daily Practice Schedule</a>
    </li>
    <li><a href="/printables/weekly-schedule">Weekly Schedule</a></li>
    <li>
      <a href="/printables/weekly-activity-planner">Weekly Activity Planner</a>
    </li>
    <li><a href="/printables/weekly-time-tracker">Weekly Time Tracker</a></li>
    <li>
      <a href="/printables/scribal-abbreviations">Scribal Abbreviations</a>
    </li>
    <li><a href="/printables/speed-reading">Speed Reading Practice</a></li>
    <li><a href="/printables/blank-sheet-music">Blank Sheet Music</a></li>
    <li><a href="/printables/perspective-grid">Perspective Grids</a></li>
  </ul>

  <h2><a href="/printables/booklets/">Booklets</a></h2>
  <p>
    Eight-page pocket booklets, each folded from one sheet with one cut and no
    staples.
  </p>
  {
    BOOKLET_GROUPS.map((group) => (
      <>
        <h3>{group.name}</h3>
        <ul>
          {group.booklets.map((booklet) => (
            <li>
              <a href={`/printables/booklets/${booklet.slug}`}>{booklet.name}</a>
            </li>
          ))}
        </ul>
      </>
    ))
  }
</Layout>
