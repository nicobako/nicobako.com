---
import { getCollection } from "astro:content";
import Layout from "../../../../../../../layouts/Layout.astro";
import Breadcrumbs from "../../../../../../../components/Breadcrumbs.astro";
import AbcTrack from "../../../../../../../components/AbcTrack.astro";
import {
  modeHref,
  tonicHref,
  VARIATIONS,
} from "../../../../../../../music/etudes/single-octave-single-string.ts";

// Every etude in the collection gets a page. The bases are written on C4 and abcjs is
// handed the offset, so this one file is the whole family.
export async function getStaticPaths() {
  const entries = await getCollection("etudes");
  return entries.map((entry) => ({
    params: {
      mode: entry.data.modeSlug,
      tonic: entry.data.tonicSlug,
      variation: entry.data.variationSlug,
    },
    props: { etude: entry.data },
  }));
}

const { etude } = Astro.props;

const description = VARIATIONS.find((v) => v.slug === etude.variationSlug)!.description;
---

<Layout
  title={`${etude.title} — Nico Bako`}
  description={`A single-octave ${etude.modeName.toLowerCase()} scale on one string, starting on ${etude.tonicName}. ${description}`}
>
  <Breadcrumbs
    trail={[
      { label: "Music", href: "/music/" },
      { label: "Etudes", href: "/music/etudes/" },
      { label: "Single octave", href: "/music/etudes/single-octave/" },
      { label: "Single string", href: "/music/etudes/single-octave/single-string/" },
      { label: etude.modeName, href: modeHref(etude.modeSlug) },
      { label: etude.tonicName, href: tonicHref(etude.modeSlug, etude.tonicSlug) },
    ]}
  />
  <h1>{etude.tonicName} {etude.modeName}</h1>
  <p class="variation">{etude.variationName} — {description}</p>

  <AbcTrack abcText={etude.abcText} transposition={etude.transposition} />
</Layout>

<style>
  .variation {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
</style>
