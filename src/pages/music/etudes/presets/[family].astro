---
import Layout from "../../../../layouts/Layout.astro";
import AbcTrack from "../../../../components/AbcTrack.astro";
import {
  PRESET_FAMILIES,
  type PresetFamily,
} from "../../../../music/etudes/presets/families.ts";
import { INSTRUMENTS } from "../../../../music/etudes/presets/instruments.ts";
import { TECHNIQUES } from "../../../../music/etudes/presets/articulations.ts";
import { MODES, degreeLetters } from "../../../../music/etudes/scale.ts";
import {
  buildEtude,
  defineEtude,
  type Etude,
} from "../../../../music/etudes/etude.ts";

export function getStaticPaths() {
  return PRESET_FAMILIES.map((family) => ({
    params: { family: family.slug },
    props: { family },
  }));
}

interface Props {
  family: PresetFamily;
}

const { family } = Astro.props;

// Every example is the same etude with one axis changed, so what the notation shows is
// the preset and nothing else. A note pattern runs its own full cycle; the other
// patterns are given eight notes of the plain scale to act on.
type Fixture = Partial<Etude> & Pick<Etude, "title">;
const FIXTURE: Fixture = {
  title: "Example",
  notes: "1 2 3 4 5 6 7 1u",
  rhythm: "q",
  bowing: "1",
  keyOffset: 2,
};

const examples =
  family.kind === "pattern"
    ? family.presets.map((preset) => {
        const etude = defineEtude({
          ...FIXTURE,
          [family.field!]: preset.value,
          // A note pattern and an articulation each run their own full cycle, since the
          // length is the thing being shown; the others act on eight notes of the scale.
          length:
            family.field === "notes" || family.field === "articulation" ? null : 8,
        });
        return { preset, result: buildEtude(etude) };
      })
    : [];

// The same eight notes on each instrument's clef: the clearest statement that a clef is
// presentation, since nothing but the drawing changes.
const clefExamples =
  family.slug === "instruments"
    ? INSTRUMENTS.map((instrument) => ({
        instrument,
        result: buildEtude(
          defineEtude({
            ...FIXTURE,
            clef: instrument.clef,
            rootOctave: instrument.rootOctave,
          }),
        ),
      }))
    : [];

// An example that cannot be built is a mistake in the preset, not something to hide.
for (const { preset, result } of examples) {
  if (result.errors.length > 0) {
    throw new Error(
      `Preset "${preset.slug}" can't be built: ${result.errors.join(" ")}`,
    );
  }
}
for (const { instrument, result } of clefExamples) {
  if (result.errors.length > 0) {
    throw new Error(
      `${instrument.name} example can't be built: ${result.errors.join(" ")}`,
    );
  }
}
---

<Layout
  title={`${family.name} — Etude Presets — Nico Bako`}
  description={family.blurb}
>
  <h1>{family.name}</h1>
  <p>{family.blurb}</p>

  {
    family.slug === "modes" && (
      <table class="degrees">
        <thead>
          <tr>
            <>
              <th>Mode</th>
              <th>Degrees 1–7, written</th>
            </>
          </tr>
        </thead>
        <tbody>
          {MODES.map((mode) => (
            <tr>
              <th scope="row">{mode.name}</th>
              <td>
                {degreeLetters(mode).map((letter) => (
                  <span class="letter">{letter}</span>
                ))}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }

  {
    family.slug === "articulations" && (
      <table class="degrees">
        <thead>
          <tr>
            <>
              <th>Code</th>
              <th>Technique</th>
              <th>Drawn</th>
              <th>Written</th>
            </>
          </tr>
        </thead>
        <tbody>
          {TECHNIQUES.map((technique) => (
            <tr>
              <th scope="row">
                <code>{technique.code}</code>
              </th>
              <td>{technique.name}</td>
              <td>{technique.mark ?? "\u2014"}</td>
              <td>
                {technique.instruction ?? "\u2014"}
                {technique.cancel && `, then ${technique.cancel}`}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }

  {
    family.slug === "articulations" && (
      <p class="description">
        A dot means staccato on the string, spiccato off it, or sautillé faster
        still, and martelé is printed with dots, accents or hammer heads depending
        on the edition — so a symbol cannot name a stroke on its own. Each technique
        that shares its symbol, or has none, writes its name once above the run instead,
        which is how a part actually tells a player.
      </p>
    )
  }

  {
    family.slug === "instruments" && (
      <table class="degrees">
        <thead>
          <tr>
            <>
              <th>Instrument</th>
              <th>Clef</th>
              <th>Root octave</th>
              <th>Open strings</th>
            </>
          </tr>
        </thead>
        <tbody>
          {INSTRUMENTS.map((instrument) => (
            <tr>
              <th scope="row">{instrument.name}</th>
              <td>{instrument.clef}</td>
              <td>{instrument.rootOctave}</td>
              <td>{instrument.strings.join(" ")}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }

  {
    family.presets.map((preset) => (
      <section class="preset">
        <h2>{preset.name}</h2>
        {preset.value !== "" && (
          <p class="pattern">
            <code>{preset.value}</code>
          </p>
        )}
        <p class="description">{preset.description}</p>
        {examples
          .filter((example) => example.preset.slug === preset.slug)
          .map((example) => (
            <AbcTrack
              abcText={example.result.abc}
              transposition={example.result.transposition}
              audio={false}
            />
          ))}
        {clefExamples
          .filter((example) => example.instrument.slug === preset.slug)
          .map((example) => (
            <AbcTrack
              abcText={example.result.abc}
              transposition={example.result.transposition}
              audio={false}
            />
          ))}
      </section>
    ))
  }

  <p class="back no-print">
    These go into the <a href="/music/etude-builder">Etude Builder</a>, which
    keeps a text box behind every picker — a preset is a starting point, not the
    only pattern allowed.
  </p>
</Layout>

<style>
  .preset {
    margin: 2.5rem 0;
  }

  .preset h2 {
    margin-bottom: 0.25rem;
  }

  .pattern {
    margin: 0 0 0.5rem;
  }

  .description {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .degrees {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 1.5rem 0;
  }

  .degrees th,
  .degrees td {
    text-align: left;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--border);
  }

  .degrees tbody th {
    font-weight: 600;
    white-space: nowrap;
  }

  .letter {
    display: inline-block;
    min-width: 1.6rem;
    font-family: var(--font-mono);
  }

  .back {
    margin-top: 3rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
