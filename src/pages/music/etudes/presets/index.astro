---
import Layout from "../../../../layouts/Layout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import { PRESET_FAMILIES, familyHref } from "../../../../music/etudes/presets/families.ts";
---

<Layout
  title="Etude Presets — Nico Bako"
  description="The named note patterns, rhythms, bowings, fingerings, modes and instruments that etudes are built from."
>
  <Breadcrumbs trail={[{ label: "Music", href: "/music/" }, { label: "Etudes", href: "/music/etudes/" }]} />
  <h1>Presets</h1>
  <p>
    An etude is a handful of patterns said at once. Each of them takes any pattern you
    care to write, and these are the ones that turned out to be worth a name — so a
    declared etude can say "broken thirds, slurred two, détaché" instead of repeating
    the strings. Every family has its own page, with the pattern written out and a bar
    or two of notation.
  </p>

  {PRESET_FAMILIES.map((family) => (
    <section class="family">
      <h2><a href={familyHref(family.slug)}>{family.name}</a></h2>
      <p class="blurb">{family.blurb}</p>
      <table>
        <thead>
          <tr><th>Name</th><th>Pattern</th></tr>
        </thead>
        <tbody>
          {family.presets.map((preset) => (
            <tr>
              <th scope="row">{preset.name}</th>
              <td><code>{preset.value || "—"}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}
</Layout>

<style>
  .family {
    margin: 2.5rem 0;
  }

  .family h2 {
    margin-bottom: 0.25rem;
  }

  .blurb {
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--border);
  }

  tbody th {
    font-weight: 600;
    white-space: nowrap;
  }

  code {
    font-size: 0.85rem;
  }
</style>
