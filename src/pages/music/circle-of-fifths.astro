---
import Layout from "../../layouts/Layout.astro";
import {
  CX,
  CY,
  KEY_INFO,
  R_INNER,
  R_MID1,
  R_MID2,
  R_OUTER,
  SEGMENTS,
} from "../../music/circle-of-fifths/circle.ts";
---

<Layout
  title="Circle of Fifths — Nico Bako"
  description="An interactive circle of fifths showing major keys, relative minors, and key signatures."
>
  <h1>Circle of Fifths</h1>
  <p>
    Click any key to see its key signature. Outer ring: major keys. Middle
    ring: relative minors. Inner ring: accidentals.
  </p>

  <!-- Wrapper so the styles can match the wheel against the panel the URL hash selects. -->
  <div class="cof-page">
    <div class="cof-wrap">
      <svg
        viewBox="0 0 440 440"
        class="cof-svg"
        aria-label="Circle of fifths"
      >
      {SEGMENTS.map((seg) => (
        <a
          class="key-group"
          href={`#key-${seg.index}`}
          aria-label={`${seg.info.major} major`}
        >
          <path class="seg-outer" d={seg.outerPath} />
          <path class="seg-mid"   d={seg.midPath} />
          <path class="seg-inner" d={seg.innerPath} />
          <text class="lbl-major" x={seg.majorPos.x} y={seg.majorPos.y}>{seg.info.major}</text>
          <text class="lbl-minor" x={seg.minorPos.x} y={seg.minorPos.y}>{seg.info.minor}</text>
          <text class="lbl-acc"   x={seg.accPos.x}   y={seg.accPos.y}>{seg.info.accLabel}</text>
        </a>
      ))}
      <circle cx={CX} cy={CY} r={R_OUTER} class="ring-outline" />
      <circle cx={CX} cy={CY} r={R_MID1}  class="ring-outline" />
      <circle cx={CX} cy={CY} r={R_MID2}  class="ring-outline" />
        <circle cx={CX} cy={CY} r={R_INNER} class="center-fill" />
      </svg>
    </div>

    <div class="key-detail">
    {KEY_INFO.map((info, i) => (
      <div class="detail-content" id={`key-${i}`}>
        <p class="detail-name">
          <strong>{info.major} major</strong>
          <span class="detail-sep"> / </span>
          <span class="detail-minor">{info.minor}</span>
        </p>
        <p class="detail-sig">Key signature: {info.accidentals}</p>
      </div>
    ))}
      <p class="detail-hint">Click a key to see its details.</p>
    </div>
  </div>
</Layout>

<style>
  .cof-wrap {
    display: flex;
    justify-content: center;
    margin: 2rem 0;
  }

  .cof-svg {
    width: 100%;
    max-width: 26rem;
    height: auto;
  }

  .key-group {
    cursor: pointer;
    outline: none;
    /* The wedges are links now, and SVG text underlines every one of them by default. */
    text-decoration: none;
  }

  .seg-outer,
  .seg-mid,
  .seg-inner {
    stroke: var(--seg-stroke);
    stroke-width: 1;
    transition: fill 0.12s;
  }

  /* Selection state is carried as colours rather than a class, because the rule that
     decides it (below) has to name each key/panel pair explicitly. */
  .key-group {
    --seg-outer-fill: var(--surface);
    --seg-mid-fill: var(--bg);
    --seg-inner-fill: var(--surface);
    --seg-stroke: var(--border);
    --lbl-major-fill: var(--text);
  }

  .seg-outer { fill: var(--seg-outer-fill); }
  .seg-mid   { fill: var(--seg-mid-fill); }
  .seg-inner { fill: var(--seg-inner-fill); }

  .key-group:hover {
    --seg-outer-fill: color-mix(in srgb, var(--accent) 12%, var(--surface));
    --seg-mid-fill: color-mix(in srgb, var(--accent) 12%, var(--surface));
    --seg-inner-fill: color-mix(in srgb, var(--accent) 12%, var(--surface));
  }

  .key-group:focus-visible .seg-outer,
  .key-group:focus-visible .seg-mid,
  .key-group:focus-visible .seg-inner {
    stroke: var(--accent);
    stroke-width: 2;
  }

  /* The wedge whose panel the URL hash selects. Following the link moves focus to the
     panel, not the wedge, so `:focus` cannot stand in for selection — and CSS has no way
     to correlate an arbitrary `:target` with an arbitrary element elsewhere in the tree.
     Hence one selector per key; they all set the same five custom properties. */
  .cof-page:has(#key-0:target) .key-group[href="#key-0"],
  .cof-page:has(#key-1:target) .key-group[href="#key-1"],
  .cof-page:has(#key-2:target) .key-group[href="#key-2"],
  .cof-page:has(#key-3:target) .key-group[href="#key-3"],
  .cof-page:has(#key-4:target) .key-group[href="#key-4"],
  .cof-page:has(#key-5:target) .key-group[href="#key-5"],
  .cof-page:has(#key-6:target) .key-group[href="#key-6"],
  .cof-page:has(#key-7:target) .key-group[href="#key-7"],
  .cof-page:has(#key-8:target) .key-group[href="#key-8"],
  .cof-page:has(#key-9:target) .key-group[href="#key-9"],
  .cof-page:has(#key-10:target) .key-group[href="#key-10"],
  .cof-page:has(#key-11:target) .key-group[href="#key-11"] {
    --seg-outer-fill: var(--accent);
    --seg-mid-fill: color-mix(in srgb, var(--accent) 25%, var(--bg));
    --seg-inner-fill: color-mix(in srgb, var(--accent) 20%, var(--surface));
    --seg-stroke: var(--accent);
    --lbl-major-fill: var(--accent-text);
  }

  .lbl-major,
  .lbl-minor,
  .lbl-acc {
    text-anchor: middle;
    dominant-baseline: middle;
    pointer-events: none;
    font-family: var(--font-sans);
  }

  .lbl-major { fill: var(--lbl-major-fill); font-size: 15px; font-weight: 600; }
  .lbl-minor { fill: var(--muted); font-size: 11px; }
  .lbl-acc   { fill: var(--muted); font-size: 10px; }

  .ring-outline {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
    pointer-events: none;
  }

  .center-fill {
    fill: var(--bg);
    stroke: var(--border);
    stroke-width: 1;
    pointer-events: none;
  }

  .key-detail {
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
    margin-top: 0.5rem;
    min-height: 4.5rem;
    text-align: center;
  }

  /* Every key's panel is in the page; the one named by the URL hash is the one shown. */
  .detail-content {
    display: none;
  }

  .detail-content:target {
    display: block;
  }

  .detail-hint {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  .key-detail:has(.detail-content:target) .detail-hint {
    display: none;
  }

  .detail-name {
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .detail-sep,
  .detail-minor {
    color: var(--muted);
  }

  .detail-sig {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 0;
  }
</style>
