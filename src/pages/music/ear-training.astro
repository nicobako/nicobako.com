---
import Layout from "../../layouts/Layout.astro";
import {
  DEFAULT_KEY,
  DEFAULT_OCTAVES,
  DEGREES,
  KEYS,
  OCTAVES,
  SOLFEGE,
  keyBySlug,
  octaveRange,
} from "../../music/ear-training/ear-training.ts";

// The page is written for C major and octave 4 — the defaults — and the script rewrites
// the seven letters and the two octave labels when the reader picks another key. Nothing
// is built from strings in the browser: the markup below is the whole page, and changing
// key only changes text inside it.
const defaultKey = keyBySlug(DEFAULT_KEY);

// Which name a degree answers to. Whether you are learning the degrees of a key or the
// absolute pitches is a real difference in what you are practising, so it is the reader's
// choice — but it changes nothing except which of the two labels is shown, so CSS hides
// one rather than the script rebuilding the buttons.
const LABEL_MODES = [
  { slug: "both", name: "Both" },
  { slug: "solfege", name: "Solfège" },
  { slug: "letters", name: "Letters" },
];
const DEFAULT_LABELS = "both";
---

<Layout
  title="Ear Training — Nico Bako"
  description="Hear a cadence to fix the key, then name the note that follows it — by solfège syllable, by letter, or both."
>
  <h1>Ear Training</h1>
  <p>
    Play the cadence first: <strong>I – IV – V – I</strong> in the key you chose,
    which is what tells your ear where <em>Do</em> is. Then ask for a note, name it,
    and check. Every note comes from the key, so there are only seven answers.
  </p>
  <p>
    Answer with the <strong>solfège</strong> syllable to practise hearing a note's place
    in the key, or with the <strong>letter</strong> to practise naming the pitch itself.
  </p>

  <form class="settings" id="settings" autocomplete="off">
    <div class="field">
      <label for="key">Key</label>
      <select id="key" name="key">
        {KEYS.map((key) => (
          <option value={key.slug} selected={key.slug === DEFAULT_KEY}>{key.name} major</option>
        ))}
      </select>
    </div>

    <fieldset class="field">
      <legend>Octaves</legend>
      <div class="checks">
        {OCTAVES.map((octave) => (
          <label class="check">
            <input
              type="checkbox"
              name="octave"
              value={octave}
              checked={DEFAULT_OCTAVES.includes(octave)}
            />
            <span data-octave-range={octave}>{octaveRange(defaultKey, octave)}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="field">
      <legend>Labels</legend>
      <div class="checks">
        {LABEL_MODES.map((mode) => (
          <label class="check">
            <input
              type="radio"
              name="labels"
              value={mode.slug}
              checked={mode.slug === DEFAULT_LABELS}
            />
            <span>{mode.name}</span>
          </label>
        ))}
      </div>
    </fieldset>
  </form>

  <div class="transport">
    <button id="cadence-btn" type="button">Play cadence</button>
    <button id="new-note-btn" type="button" class="primary">New note</button>
    <button id="replay-btn" type="button" disabled>Replay</button>
    <button id="reveal-btn" type="button" disabled>Reveal</button>
  </div>

  <p id="feedback" class="feedback" aria-live="polite">
    Play the cadence to put the key in your ear, then ask for a note.
  </p>

  <div class="answers" id="answers" data-labels={DEFAULT_LABELS} role="group" aria-label="Your answer">
    {DEGREES.map((degree) => (
      <button type="button" class="answer" data-degree={degree} disabled>
        <span class="syllable">{SOLFEGE[degree - 1]}</span>
        <span class="letter">{defaultKey.degreeNames[degree - 1]}</span>
      </button>
    ))}
  </div>

  <p id="score" class="score" aria-live="polite">No guesses yet.</p>
  <p class="hint">
    Keyboard: <kbd>1</kbd>–<kbd>7</kbd> answer, <kbd>C</kbd> cadence,
    <kbd>N</kbd> new note, <kbd>R</kbd> replay.
  </p>
</Layout>

<script>
  import {
    DEFAULT_OCTAVES,
    keyBySlug,
    notePool,
    octaveRange,
    pickNote,
    cadenceChords,
    type Key,
    type QuizNote,
  } from "../../music/ear-training/ear-training.ts";
  import { EarTrainingSynth } from "../../music/ear-training/audio.ts";

  const keySelect = document.getElementById("key") as HTMLSelectElement;
  const octaveBoxes = [...document.querySelectorAll<HTMLInputElement>("input[name='octave']")];
  const answersEl = document.getElementById("answers") as HTMLElement;
  const answerBtns = [...document.querySelectorAll<HTMLButtonElement>(".answer")];
  const feedbackEl = document.getElementById("feedback")!;
  const scoreEl = document.getElementById("score")!;

  const button = (id: string) => document.getElementById(id) as HTMLButtonElement;
  const cadenceBtn = button("cadence-btn");
  const newNoteBtn = button("new-note-btn");
  const replayBtn = button("replay-btn");
  const revealBtn = button("reveal-btn");

  const synth = new EarTrainingSynth();

  let key: Key = keyBySlug(keySelect.value);
  let pool: QuizNote[] = [];
  let current: QuizNote | null = null;
  /** The question has been counted — the first guess is in, or the answer was revealed. */
  let scored = false;
  /** The answer is known, so the buttons are done taking guesses. */
  let resolved = false;
  let asked = 0;
  let right = 0;

  /** The twelve slugs the `key` parameter is allowed to name. */
  const KEY_SLUGS = new Set([...keySelect.options].map((option) => option.value));

  /**
   * Which control each URL parameter restores. Like the etude builder, the query string
   * is the whole store: the settings are three values, so a bookmark is a practice setup
   * and there is no second copy in localStorage to fall out of step with the page.
   */
  function restoreFromUrl(): void {
    const params = new URLSearchParams(location.search);

    const wanted = params.get("key");
    if (wanted && KEY_SLUGS.has(wanted)) keySelect.value = wanted;

    const octaves = params.get("octaves");
    if (octaves) {
      const chosen = new Set(octaves.split(","));
      for (const box of octaveBoxes) box.checked = chosen.has(box.value);
    }

    const labels = params.get("labels");
    const radio = labels
      ? document.querySelector<HTMLInputElement>(`input[name='labels'][value='${CSS.escape(labels)}']`)
      : null;
    if (radio) radio.checked = true;
  }

  function writeUrl(): void {
    const url = new URL(location.href);
    url.search = "";
    url.searchParams.set("key", keySelect.value);
    url.searchParams.set("octaves", selectedOctaves().join(","));
    url.searchParams.set("labels", labelMode());
    history.replaceState(null, "", url);
  }

  function selectedOctaves(): number[] {
    return octaveBoxes.filter((box) => box.checked).map((box) => Number(box.value));
  }

  function labelMode(): string {
    const checked = document.querySelector<HTMLInputElement>("input[name='labels']:checked");
    return checked ? checked.value : "both";
  }

  /** Read the settings back out of the form and rebuild everything that depends on them. */
  function applySettings(): void {
    key = keyBySlug(keySelect.value);

    let octaves = selectedOctaves();
    if (octaves.length === 0) {
      // Unchecking the last octave would leave nothing to play, so it goes back on.
      const fallback =
        octaveBoxes.find((box) => Number(box.value) === DEFAULT_OCTAVES[0]) ?? octaveBoxes[0]!;
      fallback.checked = true;
      octaves = [Number(fallback.value)];
    }
    pool = notePool(key, octaves);

    for (const btn of answerBtns) {
      const degree = Number(btn.dataset.degree);
      btn.querySelector(".letter")!.textContent = key.degreeNames[degree - 1]!;
    }
    for (const box of octaveBoxes) {
      const octave = Number(box.value);
      const label = document.querySelector(`[data-octave-range="${octave}"]`)!;
      label.textContent = octaveRange(key, octave);
    }

    writeUrl();
  }

  /** How to say a note, in whichever of its two names the reader is practising. */
  function describe(note: QuizNote): string {
    const mode = answersEl.dataset.labels;
    if (mode === "solfege") return note.solfege;
    if (mode === "letters") return note.name;
    return `${note.solfege} (${note.name})`;
  }

  function clearQuestion(message: string): void {
    synth.stop();
    current = null;
    scored = false;
    resolved = false;
    for (const btn of answerBtns) {
      btn.classList.remove("correct", "wrong");
      btn.disabled = true;
    }
    replayBtn.disabled = true;
    revealBtn.disabled = true;
    feedbackEl.textContent = message;
  }

  function resetScore(): void {
    asked = 0;
    right = 0;
    showScore();
  }

  function showScore(): void {
    scoreEl.textContent =
      asked === 0 ? "No guesses yet." : `${right} of ${asked} named on the first guess.`;
  }

  function newQuestion(): void {
    const note = pickNote(pool, current);
    if (!note) return;
    current = note;
    scored = false;
    resolved = false;
    for (const btn of answerBtns) {
      btn.classList.remove("correct", "wrong");
      btn.disabled = false;
    }
    replayBtn.disabled = false;
    revealBtn.disabled = false;
    feedbackEl.textContent = "Listening — which note is it?";
    synth.playNote(note.freq);
  }

  function guess(degree: number): void {
    if (!current || resolved) return;
    const btn = answerBtns.find((b) => Number(b.dataset.degree) === degree);
    if (!btn) return;

    const correct = degree === current.degree;
    if (!scored) {
      scored = true;
      asked++;
      if (correct) right++;
      showScore();
    }

    if (correct) {
      resolved = true;
      btn.classList.add("correct");
      feedbackEl.textContent = `Yes — ${describe(current)}.`;
      for (const other of answerBtns) other.disabled = true;
      revealBtn.disabled = true;
    } else {
      btn.classList.add("wrong");
      btn.disabled = true;
      feedbackEl.textContent = "Not that one — listen again.";
    }
  }

  function reveal(): void {
    if (!current || resolved) return;
    if (!scored) {
      scored = true;
      asked++;
      showScore();
    }
    resolved = true;
    const answer = answerBtns.find((b) => Number(b.dataset.degree) === current!.degree)!;
    answer.classList.remove("wrong");
    answer.classList.add("correct");
    for (const btn of answerBtns) btn.disabled = true;
    revealBtn.disabled = true;
    feedbackEl.textContent = `It was ${describe(current)}.`;
  }

  keySelect.addEventListener("change", () => {
    applySettings();
    // A score mixing two keys says nothing, so a change of key starts a fresh session.
    resetScore();
    clearQuestion(`${key.name} major. Play the cadence, then ask for a note.`);
  });

  for (const box of octaveBoxes) {
    box.addEventListener("change", () => {
      applySettings();
      resetScore();
      clearQuestion("Octaves changed. Ask for a note when you are ready.");
    });
  }

  for (const radio of document.querySelectorAll<HTMLInputElement>("input[name='labels']")) {
    radio.addEventListener("change", () => {
      answersEl.dataset.labels = labelMode();
      writeUrl();
    });
  }

  cadenceBtn.addEventListener("click", () => {
    synth.playChords(cadenceChords(key, selectedOctaves()), 0.7);
    if (!current) feedbackEl.textContent = `That is ${key.name} major. Now ask for a note.`;
  });

  newNoteBtn.addEventListener("click", newQuestion);
  replayBtn.addEventListener("click", () => {
    if (current) synth.playNote(current.freq);
  });
  revealBtn.addEventListener("click", reveal);

  for (const btn of answerBtns) {
    btn.addEventListener("click", () => guess(Number(btn.dataset.degree)));
  }

  document.addEventListener("keydown", (event) => {
    if (event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target as HTMLElement | null;
    if (target && (target.matches("input, select, textarea") || target.isContentEditable)) return;

    const degree = Number(event.key);
    if (degree >= 1 && degree <= 7) {
      event.preventDefault();
      guess(degree);
      return;
    }
    const shortcuts: Record<string, HTMLButtonElement> = {
      c: cadenceBtn,
      n: newNoteBtn,
      r: replayBtn,
    };
    const btn = shortcuts[event.key.toLowerCase()];
    if (btn && !btn.disabled) {
      event.preventDefault();
      btn.click();
    }
  });

  restoreFromUrl();
  applySettings();
  answersEl.dataset.labels = labelMode();
  showScore();
</script>

<style>
  .settings {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    margin-top: 2rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 0;
    padding: 0;
    margin: 0;
  }

  .field > label,
  .field legend {
    padding: 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }

  .field select {
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
    font-size: 0.95rem;
  }

  .checks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--text);
  }

  .transport {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .transport button {
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color 0.12s,
      color 0.12s,
      background 0.12s;
  }

  .transport button:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .transport button.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-text);
  }

  .transport button.primary:hover:not(:disabled) {
    background: var(--bg);
    color: var(--accent);
  }

  .transport button:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .feedback {
    margin: 1.25rem 0 0;
    min-height: 1.6em;
    font-size: 1.05rem;
  }

  .answers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(5rem, 1fr));
    gap: 0.6rem;
    margin-top: 0.75rem;
  }

  .answer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    padding: 0.7rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition:
      border-color 0.12s,
      background 0.12s,
      color 0.12s;
  }

  .answer .syllable {
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .answer .letter {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.2;
  }

  /* The label mode only decides which of the two names is on show, so it is a class
     switch rather than a rebuild. */
  .answers[data-labels="solfege"] .letter,
  .answers[data-labels="letters"] .syllable {
    display: none;
  }

  .answers[data-labels="letters"] .letter {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
  }

  .answer:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .answer:disabled {
    cursor: default;
    opacity: 0.5;
  }

  .answer.correct,
  .answer.correct:disabled {
    opacity: 1;
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-text);
  }

  .answer.correct .letter {
    color: var(--accent-text);
  }

  .answer.wrong,
  .answer.wrong:disabled {
    opacity: 1;
    border-color: #c0392b;
    color: #c0392b;
    background: var(--surface);
  }

  .answer.wrong .letter {
    color: #c0392b;
  }

  @media (prefers-color-scheme: dark) {
    .answer.wrong,
    .answer.wrong:disabled,
    .answer.wrong .letter {
      border-color: #ff8a80;
      color: #ff8a80;
    }
  }

  .score {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .hint {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  kbd {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.8em;
  }
</style>
