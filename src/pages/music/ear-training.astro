---
import Layout from "../../layouts/Layout.astro";
import {
  DEFAULT_KEY,
  DEFAULT_OCTAVES,
  DEFAULT_THINKING,
  KEYS,
  OCTAVES,
  THINKING_TIMES,
  keyBySlug,
  octaveRange,
} from "../../music/ear-training/ear-training.ts";

// The page is written for C major, octave 4, no accidentals — the defaults — and the
// script rewrites the twelve labels and the octave ranges when the reader picks another
// key. Nothing is built from strings in the browser: the markup below is the whole page,
// and changing key only changes text inside it.
const defaultKey = keyBySlug(DEFAULT_KEY);

const KEY_GROUPS = [
  { name: "Major", keys: KEYS.filter((key) => key.mode === "major") },
  { name: "Minor", keys: KEYS.filter((key) => key.mode === "minor") },
];

// Which name a degree answers to. Whether you are learning the degrees of a key or the
// absolute pitches is a real difference in what you are practising, so it is the reader's
// choice — but it changes nothing except which of the two labels is shown, so CSS hides
// one rather than the script rebuilding the buttons.
const LABEL_MODES = [
  { slug: "both", name: "Both" },
  { slug: "solfege", name: "Solfège" },
  { slug: "letters", name: "Letters" },
];
const DEFAULT_LABELS = "both";
---

<Layout
  title="Ear Training — Nico Bako"
  description="Hear a cadence to fix the key, then name the note that follows it — by solfège syllable, by letter, or both, in any major or minor key."
>
  <h1>Ear Training</h1>
  <p>
    Play the cadence first — <strong>I – IV – V – I</strong>, major or minor to match
    the key you chose — which is what tells your ear where <em>Do</em> is. Then ask for
    a note, name it, and check.
  </p>
  <p>
    Answer with the <strong>solfège</strong> syllable to practise hearing a note's place
    in the key, or with the <strong>letter</strong> to practise naming the pitch itself.
    Switch <strong>accidentals</strong> on and the questions come from all twelve
    semitones rather than the seven of the key — an off-scale note answers to two names
    each way, the degree below it raised or the one above it lowered, and either counts.
  </p>
  <p>
    <strong>Auto-play</strong> runs the whole thing hands-free, for practising somewhere
    you cannot look at a screen. It plays the cadence, plays a note, waits while you name
    it, and then answers out loud the only way sound can: it climbs the scale from the
    tonic up to the note, so a run of <em>Do Re Mi Fa</em> tells you the note was
    <em>Fa</em>. Then it asks the next one.
  </p>

  <form class="settings" id="settings" autocomplete="off">
    <div class="field">
      <label for="key">Key</label>
      <select id="key" name="key">
        {KEY_GROUPS.map((group) => (
          <optgroup label={group.name}>
            {group.keys.map((key) => (
              <option value={key.slug} selected={key.slug === DEFAULT_KEY}>{key.label}</option>
            ))}
          </optgroup>
        ))}
      </select>
    </div>

    <fieldset class="field">
      <legend>Octaves</legend>
      <div class="checks">
        {OCTAVES.map((octave) => (
          <label class="check">
            <input
              type="checkbox"
              name="octave"
              value={octave}
              checked={DEFAULT_OCTAVES.includes(octave)}
            />
            <span data-octave-range={octave}>{octaveRange(defaultKey, octave)}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="field">
      <legend>Labels</legend>
      <div class="checks">
        {LABEL_MODES.map((mode) => (
          <label class="check">
            <input
              type="radio"
              name="labels"
              value={mode.slug}
              checked={mode.slug === DEFAULT_LABELS}
            />
            <span>{mode.name}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="field">
      <legend>Notes</legend>
      <div class="checks">
        <label class="check">
          <input id="accidentals" type="checkbox" />
          <span>Accidentals</span>
        </label>
      </div>
    </fieldset>

    <div class="field">
      <label for="thinking">Thinking time</label>
      <select id="thinking" name="thinking">
        {THINKING_TIMES.map((seconds) => (
          <option value={seconds} selected={seconds === DEFAULT_THINKING}>{seconds} seconds</option>
        ))}
      </select>
    </div>
  </form>

  <div class="transport">
    <button id="auto-btn" type="button" class="toggle" aria-pressed="false">Auto-play</button>
    <button id="cadence-btn" type="button">Play cadence</button>
    <button id="new-note-btn" type="button" class="primary">New note</button>
    <button id="replay-btn" type="button" disabled>Replay</button>
    <button id="reveal-btn" type="button" disabled>Reveal</button>
  </div>

  <p id="feedback" class="feedback" aria-live="polite">
    Play the cadence to put the key in your ear, then ask for a note.
  </p>

  <div
    class="answers"
    id="answers"
    data-labels={DEFAULT_LABELS}
    data-accidentals="off"
    role="group"
    aria-label="Your answer"
  >
    {defaultKey.tones.map((tone) => (
      <button
        type="button"
        class="answer"
        data-offset={tone.offset}
        data-diatonic={String(tone.diatonic)}
        disabled
      >
        <span class="syllable">{tone.solfege}</span>
        <span class="letter">{tone.letter}</span>
      </button>
    ))}
  </div>

  <p id="score" class="score" aria-live="polite">No guesses yet.</p>
  <p class="hint">
    Keyboard: the number row answers left to right, <kbd>A</kbd> auto-play,
    <kbd>C</kbd> cadence, <kbd>N</kbd> new note, <kbd>R</kbd> replay.
  </p>
</Layout>

<script>
  import {
    DEFAULT_OCTAVES,
    answerRun,
    cadenceChords,
    keyBySlug,
    notePool,
    octaveRange,
    pickNote,
    type Key,
    type QuizNote,
  } from "../../music/ear-training/ear-training.ts";
  import { ToneSynth } from "../../music/synth.ts";

  const keySelect = document.getElementById("key") as HTMLSelectElement;
  const octaveBoxes = [...document.querySelectorAll<HTMLInputElement>("input[name='octave']")];
  const accidentalsBox = document.getElementById("accidentals") as HTMLInputElement;
  const thinkingSelect = document.getElementById("thinking") as HTMLSelectElement;
  const answersEl = document.getElementById("answers") as HTMLElement;
  const answerBtns = [...document.querySelectorAll<HTMLButtonElement>(".answer")];
  const feedbackEl = document.getElementById("feedback")!;
  const scoreEl = document.getElementById("score")!;

  const button = (id: string) => document.getElementById(id) as HTMLButtonElement;
  const autoBtn = button("auto-btn");
  const cadenceBtn = button("cadence-btn");
  const newNoteBtn = button("new-note-btn");
  const replayBtn = button("replay-btn");
  const revealBtn = button("reveal-btn");

  const synth = new ToneSynth();

  /** How long one note of an answer run lasts, and the silence between parts of a round. */
  const RUN_STEP = 0.32;
  const GAP = 0.6;

  let key: Key = keyBySlug(keySelect.value);
  let pool: QuizNote[] = [];
  let current: QuizNote | null = null;
  /** The last note asked, kept past the end of its question so the next one differs. */
  let previous: QuizNote | null = null;
  /** The question has been counted — the first guess is in, or the answer was revealed. */
  let scored = false;
  /** The answer is known, so the buttons are done taking guesses. */
  let resolved = false;
  let asked = 0;
  let right = 0;

  /** The twenty-four slugs the `key` parameter is allowed to name. */
  const KEY_SLUGS = new Set([...keySelect.options].map((option) => option.value));

  /**
   * Which control each URL parameter restores. Like the etude builder, the query string
   * is the whole store: the settings are four values, so a bookmark is a practice setup
   * and there is no second copy in localStorage to fall out of step with the page.
   */
  function restoreFromUrl(): void {
    const params = new URLSearchParams(location.search);

    const wanted = params.get("key");
    if (wanted && KEY_SLUGS.has(wanted)) keySelect.value = wanted;

    const octaves = params.get("octaves");
    if (octaves) {
      const chosen = new Set(octaves.split(","));
      for (const box of octaveBoxes) box.checked = chosen.has(box.value);
    }

    const labels = params.get("labels");
    const radio = labels
      ? document.querySelector<HTMLInputElement>(`input[name='labels'][value='${CSS.escape(labels)}']`)
      : null;
    if (radio) radio.checked = true;

    if (params.has("acc")) accidentalsBox.checked = params.get("acc") === "1";

    const thinking = params.get("think");
    if (thinking && [...thinkingSelect.options].some((option) => option.value === thinking)) {
      thinkingSelect.value = thinking;
    }
  }

  function writeUrl(): void {
    const url = new URL(location.href);
    url.search = "";
    url.searchParams.set("key", keySelect.value);
    url.searchParams.set("octaves", selectedOctaves().join(","));
    url.searchParams.set("labels", labelMode());
    if (accidentalsBox.checked) url.searchParams.set("acc", "1");
    url.searchParams.set("think", thinkingSelect.value);
    history.replaceState(null, "", url);
  }

  function selectedOctaves(): number[] {
    return octaveBoxes.filter((box) => box.checked).map((box) => Number(box.value));
  }

  function labelMode(): string {
    const checked = document.querySelector<HTMLInputElement>("input[name='labels']:checked");
    return checked ? checked.value : "both";
  }

  /** The buttons on show: the whole octave, or only the notes the key is built from. */
  function visibleAnswers(): HTMLButtonElement[] {
    if (accidentalsBox.checked) return answerBtns;
    return answerBtns.filter((btn) => btn.dataset.diatonic === "true");
  }

  /** Read the settings back out of the form and rebuild everything that depends on them. */
  function applySettings(): void {
    key = keyBySlug(keySelect.value);

    let octaves = selectedOctaves();
    if (octaves.length === 0) {
      // Unchecking the last octave would leave nothing to play, so it goes back on.
      const fallback =
        octaveBoxes.find((box) => Number(box.value) === DEFAULT_OCTAVES[0]) ?? octaveBoxes[0]!;
      fallback.checked = true;
      octaves = [Number(fallback.value)];
    }
    pool = notePool(key, octaves, accidentalsBox.checked);

    for (const btn of answerBtns) {
      const tone = key.tones[Number(btn.dataset.offset)]!;
      btn.dataset.diatonic = String(tone.diatonic);
      btn.querySelector(".syllable")!.textContent = tone.solfege;
      btn.querySelector(".letter")!.textContent = tone.letter;
    }
    answersEl.dataset.accidentals = accidentalsBox.checked ? "on" : "off";

    for (const box of octaveBoxes) {
      const octave = Number(box.value);
      const label = document.querySelector(`[data-octave-range="${octave}"]`)!;
      label.textContent = octaveRange(key, octave);
    }

    writeUrl();
  }

  /** How to say a note, in whichever of its two names the reader is practising. */
  function describe(note: QuizNote): string {
    const mode = answersEl.dataset.labels;
    if (mode === "solfege") return note.solfege;
    if (mode === "letters") return note.name;
    return `${note.solfege} (${note.name})`;
  }

  function clearQuestion(message: string): void {
    synth.stop();
    current = null;
    scored = false;
    resolved = false;
    for (const btn of answerBtns) {
      btn.classList.remove("correct", "wrong");
      btn.disabled = true;
    }
    replayBtn.disabled = true;
    revealBtn.disabled = true;
    feedbackEl.textContent = message;
  }

  function resetScore(): void {
    asked = 0;
    right = 0;
    showScore();
  }

  function showScore(): void {
    scoreEl.textContent =
      asked === 0 ? "No guesses yet." : `${right} of ${asked} named on the first guess.`;
  }

  /** Ask one. Returns how long the note sounds for, in seconds. */
  function newQuestion(): number {
    const note = pickNote(pool, previous);
    if (!note) return 0;
    previous = note;
    current = note;
    scored = false;
    resolved = false;
    for (const btn of answerBtns) {
      btn.classList.remove("correct", "wrong");
      btn.disabled = false;
    }
    replayBtn.disabled = false;
    revealBtn.disabled = false;
    feedbackEl.textContent = "Listening — which note is it?";
    return synth.playNote(note.freq);
  }

  function answerFor(offset: number): HTMLButtonElement | undefined {
    return visibleAnswers().find((btn) => Number(btn.dataset.offset) === offset);
  }

  function guess(offset: number): void {
    if (!current || resolved) return;
    const btn = answerFor(offset);
    if (!btn || btn.disabled) return;

    const correct = offset === current.offset;
    if (!scored) {
      scored = true;
      asked++;
      if (correct) right++;
      showScore();
    }

    if (correct) {
      resolved = true;
      btn.classList.add("correct");
      feedbackEl.textContent = `Yes — ${describe(current)}.`;
      for (const other of answerBtns) other.disabled = true;
      revealBtn.disabled = true;
    } else {
      btn.classList.add("wrong");
      btn.disabled = true;
      feedbackEl.textContent = "Not that one — listen again.";
    }
  }

  /**
   * Give the answer, on the page and out loud: the scale climbed from the tonic up to the
   * note, which is the only way to name a note to someone who cannot look at a screen.
   * Returns how long that run takes. Asking to be told counts as a miss; the auto-play
   * loop running out of patience does not, since nobody may have been listening.
   */
  function reveal(count: boolean): number {
    if (!current || resolved) return 0;
    if (count && !scored) {
      scored = true;
      asked++;
      showScore();
    }
    resolved = true;
    const answer = answerFor(current.offset);
    if (answer) {
      answer.classList.remove("wrong");
      answer.classList.add("correct");
    }
    for (const btn of answerBtns) btn.disabled = true;
    revealBtn.disabled = true;
    feedbackEl.textContent = `It was ${describe(current)}.`;
    return synth.playMelody(answerRun(key, current, accidentalsBox.checked), RUN_STEP);
  }

  /**
   * A change to what can be played starts a fresh session: a score spanning two keys says
   * nothing. The message is a function so it is worded from the settings as they now are.
   */
  function settingsChanged(message: () => string): void {
    setAuto(false);
    applySettings();
    resetScore();
    previous = null;
    clearQuestion(message());
  }

  keySelect.addEventListener("change", () => {
    settingsChanged(() => `${key.label}. Play the cadence, then ask for a note.`);
  });

  for (const box of octaveBoxes) {
    box.addEventListener("change", () => {
      settingsChanged(() => "Octaves changed. Ask for a note when you are ready.");
    });
  }

  accidentalsBox.addEventListener("change", () => {
    settingsChanged(() =>
      accidentalsBox.checked
        ? "All twelve semitones are in play now."
        : "Back to the notes of the key.",
    );
  });

  for (const radio of document.querySelectorAll<HTMLInputElement>("input[name='labels']")) {
    radio.addEventListener("change", () => {
      answersEl.dataset.labels = labelMode();
      writeUrl();
    });
  }

  thinkingSelect.addEventListener("change", writeUrl);

  /* ------------------------------------------------------------------ *
   * Auto-play: the same round the buttons play, on a timer
   * ------------------------------------------------------------------ */

  let autoRunning = false;
  let autoTimer: number | null = null;

  /**
   * Each part of a round is scheduled from the length of the one before it, which the
   * synth reports, so the timer only ever waits for silence. The audio inside a part is
   * still placed on the audio clock; `setTimeout` is only deciding when the next part
   * begins, and is allowed to be a few milliseconds late about it.
   */
  function later(seconds: number, next: () => void): void {
    autoTimer = window.setTimeout(() => {
      if (autoRunning) next();
    }, seconds * 1000);
  }

  function autoRound(): void {
    if (!autoRunning) return;
    clearQuestion(`${key.label} — here is the cadence.`);
    const cadence = synth.playChords(cadenceChords(key, selectedOctaves()), 0.7);
    later(cadence + GAP, () => {
      const note = newQuestion();
      later(note + Number(thinkingSelect.value), () => {
        // A question already answered needs no run; the round just moves on.
        later(reveal(false) + GAP, autoRound);
      });
    });
  }

  /**
   * A screen wake lock, so a phone left running in a car does not lock itself and take
   * the audio with it. Browsers may refuse it or not have it at all, which is fine — the
   * loop runs either way — and it is dropped as soon as auto-play stops.
   */
  let wakeLock: WakeLockSentinel | null = null;

  async function keepAwake(on: boolean): Promise<void> {
    try {
      if (on) {
        wakeLock = await navigator.wakeLock.request("screen");
        wakeLock.addEventListener("release", () => {
          wakeLock = null;
        });
      } else if (wakeLock) {
        await wakeLock.release();
        wakeLock = null;
      }
    } catch {
      wakeLock = null;
    }
  }

  document.addEventListener("visibilitychange", () => {
    // A lock is lost whenever the page is hidden, so it has to be taken again on return.
    if (autoRunning && !wakeLock && document.visibilityState === "visible") void keepAwake(true);
  });

  function setAuto(on: boolean): void {
    if (on === autoRunning) return;
    autoRunning = on;
    autoBtn.classList.toggle("active", on);
    autoBtn.setAttribute("aria-pressed", String(on));
    autoBtn.textContent = on ? "Stop" : "Auto-play";
    cadenceBtn.disabled = on;
    newNoteBtn.disabled = on;
    void keepAwake(on);

    if (on) {
      autoRound();
      return;
    }
    if (autoTimer !== null) clearTimeout(autoTimer);
    autoTimer = null;
    clearQuestion("Stopped.");
  }

  autoBtn.addEventListener("click", () => setAuto(!autoRunning));

  cadenceBtn.addEventListener("click", () => {
    synth.playChords(cadenceChords(key, selectedOctaves()), 0.7);
    if (!current) feedbackEl.textContent = `That is ${key.label}. Now ask for a note.`;
  });

  newNoteBtn.addEventListener("click", newQuestion);
  replayBtn.addEventListener("click", () => {
    if (current) synth.playNote(current.freq);
  });
  revealBtn.addEventListener("click", () => reveal(true));

  for (const btn of answerBtns) {
    btn.addEventListener("click", () => guess(Number(btn.dataset.offset)));
  }

  /**
   * The number row answers left to right, so the same keys work whether there are seven
   * buttons on show or twelve — a fixed key per scale degree would leave the accidentals
   * unreachable.
   */
  const KEYBOARD_ORDER = "1234567890-=";

  document.addEventListener("keydown", (event) => {
    if (event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target as HTMLElement | null;
    if (target && (target.matches("input, select, textarea") || target.isContentEditable)) return;

    const position = KEYBOARD_ORDER.indexOf(event.key);
    if (position >= 0) {
      const btn = visibleAnswers()[position];
      if (btn) {
        event.preventDefault();
        guess(Number(btn.dataset.offset));
      }
      return;
    }

    const shortcuts: Record<string, HTMLButtonElement> = {
      a: autoBtn,
      c: cadenceBtn,
      n: newNoteBtn,
      r: replayBtn,
    };
    const btn = shortcuts[event.key.toLowerCase()];
    if (btn && !btn.disabled) {
      event.preventDefault();
      btn.click();
    }
  });

  restoreFromUrl();
  applySettings();
  answersEl.dataset.labels = labelMode();
  showScore();
</script>

<style>
  .settings {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    margin-top: 2rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 0;
    padding: 0;
    margin: 0;
  }

  .field > label,
  .field legend {
    padding: 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }

  .field select {
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
    font-size: 0.95rem;
  }

  .checks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--text);
  }

  .transport {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .transport button {
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color 0.12s,
      color 0.12s,
      background 0.12s;
  }

  .transport button:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .transport button.toggle {
    border-color: var(--accent);
    color: var(--accent);
  }

  .transport button.toggle.active {
    background: var(--accent);
    color: var(--accent-text);
  }

  .transport button.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-text);
  }

  .transport button.primary:hover:not(:disabled) {
    background: var(--bg);
    color: var(--accent);
  }

  .transport button:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .feedback {
    margin: 1.25rem 0 0;
    min-height: 1.6em;
    font-size: 1.05rem;
  }

  .answers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(5.25rem, 1fr));
    gap: 0.6rem;
    margin-top: 0.75rem;
  }

  .answer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    padding: 0.7rem 0.3rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition:
      border-color 0.12s,
      background 0.12s,
      color 0.12s;
  }

  /* A note from outside the key is drawn as one, so the seven of the key still read as
     the frame the others hang off. */
  .answer[data-diatonic="false"] {
    border-style: dashed;
  }

  /* Whether the accidentals are in play changes which buttons are on show, not what they
     say, so it is an attribute the CSS reads rather than a rebuild. */
  .answers[data-accidentals="off"] .answer[data-diatonic="false"] {
    display: none;
  }

  .answer .syllable {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .answer .letter {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.2;
  }

  /* The label mode only decides which of the two names is on show, so it is a class
     switch rather than a rebuild. */
  .answers[data-labels="solfege"] .letter,
  .answers[data-labels="letters"] .syllable {
    display: none;
  }

  .answers[data-labels="letters"] .letter {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
  }

  .answer:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .answer:disabled {
    cursor: default;
    opacity: 0.5;
  }

  .answer.correct,
  .answer.correct:disabled {
    opacity: 1;
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-text);
  }

  .answer.correct .letter {
    color: var(--accent-text);
  }

  .answer.wrong,
  .answer.wrong:disabled {
    opacity: 1;
    border-color: #c0392b;
    color: #c0392b;
    background: var(--surface);
  }

  .answer.wrong .letter {
