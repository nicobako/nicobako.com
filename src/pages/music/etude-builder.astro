---
import Layout from "../../layouts/Layout.astro";
import { MODES, RHYTHM_NAMES } from "../../music/etude-builder/etude.ts";

// The starting etude: a scale in broken thirds, slurred two at a time, against a rhythm
// that does not divide the pattern — so the default page already shows the point of the
// tool rather than a plain scale.
const DEFAULTS = {
  title: "Etude",
  notes: "1 2 3 4 5 6 7 1'",
  rhythm: "q e e",
  bowing: "2 1 1",
  mode: "major",
  meter: "4/4",
  tempo: 72,
};

// Hand-picked patterns, one row per field. These are the presets worth having as a
// starting point; the text box behind them is what makes any other pattern possible.
const PRESETS: { field: string; label: string; items: { name: string; value: string }[] }[] = [
  {
    field: "notes",
    label: "Note presets",
    items: [
      { name: "Scale", value: "1 2 3 4 5 6 7 1'" },
      { name: "Up and down", value: "1 2 3 4 5 6 7 1' 7 6 5 4 3 2" },
      { name: "Broken thirds", value: "1 3 2 4 3 5 4 6 5 7 6 1'" },
      { name: "Arpeggio", value: "1 3 5 1' 5 3" },
      { name: "Turns", value: "1 2 1 7, 1 3 2 1" },
      { name: "Pedal tonic", value: "1 2 1 3 1 4 1 5" },
      { name: "Thirds", value: "1+3 2+4 3+5 4+6 5+7 6+1'" },
      { name: "Sixths", value: "1+6 2+7 3+1' 4+2'" },
      { name: "Octaves", value: "1+1' 2+2' 3+3' 4+4'" },
    ],
  },
  {
    field: "rhythm",
    label: "Rhythm presets",
    items: [
      { name: "Quarters", value: "q" },
      { name: "Eighths", value: "e" },
      { name: "Sixteenths", value: "s" },
      { name: "Long–short–short", value: "q e e" },
      { name: "Gallop", value: "e. s" },
      { name: "Reverse gallop", value: "s e." },
    ],
  },
  {
    field: "bowing",
    label: "Bowing presets",
    items: [
      { name: "Détaché", value: "1" },
      { name: "Slur 2", value: "2" },
      { name: "Slur 4", value: "4" },
      { name: "3 + 1", value: "3 1" },
      { name: "1 + 3", value: "1 3" },
      { name: "Slur 2, then two singles", value: "2 1 1" },
    ],
  },
];

const METERS = ["4/4", "3/4", "2/4", "6/8", "5/4"];
---

<Layout
  title="Etude Builder — Nico Bako"
  description="Build your own violin etude from a note pattern, a rhythm and a bowing, and hear it played back."
>
  <h1 class="no-print">Etude Builder</h1>
  <p class="no-print">
    An etude is a short pattern said several ways at once: which notes, which
    fingers, which rhythm, which bowing. Type the three patterns below and they
    are cycled against each other — five notes against a rhythm of three against
    a bowing of two do not repeat for thirty notes. The tune runs until all three
    line up again. Transpose the finished etude with the &minus;/+ control on the
    score, and the URL updates as you type, so a bookmark is an etude.
  </p>

  <form class="builder no-print" id="builder" autocomplete="off">
    <div class="field">
      <label for="notes">Notes</label>
      <input id="notes" name="notes" type="text" spellcheck="false" value={DEFAULTS.notes} />
      <p class="hint">
        Scale degrees <code>1</code>–<code>7</code>. Add <code>'</code> for an
        octave up and <code>,</code> for an octave down, <code>#</code> or
        <code>b</code> in front to alter the degree (<code>#7</code> gives
        harmonic minor), and a finger in parentheses where you want one marked:
        <code>1(1)</code>, <code>5(0)</code> for an open string. A marked finger
        travels with its note, so it stays right when the pattern repeats. Join
        notes with <code>+</code> for a double stop — <code>1+3</code>, or
        <code>1(1)+3(3)</code> to finger both. A double stop takes one bow and
        one rhythm value, the same as any single note.
      </p>
    </div>

    <div class="field">
      <label for="rhythm">Rhythm</label>
      <input id="rhythm" name="rhythm" type="text" spellcheck="false" value={DEFAULTS.rhythm} />
      <p class="hint">
        {RHYTHM_NAMES.map(([letter, name], i) => (
          <>{i > 0 ? ", " : ""}<code>{letter}</code>{` ${name}`}</>
        ))}. Add a dot for dotted: <code>q.</code>
      </p>
    </div>

    <div class="field">
      <label for="bowing">Bowing</label>
      <input id="bowing" name="bowing" type="text" spellcheck="false" value={DEFAULTS.bowing} />
      <p class="hint">
        Slur lengths — how many notes go under one bow. <code>2 2 1 1</code> is
        slur two, slur two, then two separate bows. Bow direction just alternates,
        so it is worked out for you rather than typed.
      </p>
    </div>

    <div class="row">
      <div class="field field-small">
        <label for="mode">Mode</label>
        <select id="mode" name="mode">
          {MODES.map((mode) => (
            <option value={mode.slug} selected={mode.slug === DEFAULTS.mode}>{mode.name}</option>
          ))}
        </select>
      </div>

      <div class="field field-small">
        <label for="meter">Meter</label>
        <select id="meter" name="meter">
          {METERS.map((meter) => (
            <option value={meter} selected={meter === DEFAULTS.meter}>{meter}</option>
          ))}
        </select>
      </div>

      <div class="field field-small">
        <label for="tempo">Tempo</label>
        <input id="tempo" name="tempo" type="number" min="30" max="208" value={DEFAULTS.tempo} />
      </div>

      <div class="field field-small">
        <label for="length">Length</label>
        <input id="length" name="length" type="number" min="1" max="192" placeholder="auto" />
      </div>

      <div class="field field-small">
        <label for="title">Title</label>
        <input id="title" name="title" type="text" value={DEFAULTS.title} />
      </div>
    </div>

    <div class="row checks">
      <label class="check"><input id="show-bowings" type="checkbox" checked /> Mark bow directions</label>
      <label class="check"><input id="start-up-bow" type="checkbox" /> Start up-bow</label>
    </div>

    {PRESETS.map((group) => (
      <div class="presets" role="group" aria-label={group.label}>
        <span class="presets-label">{group.label}</span>
        {group.items.map((item) => (
          <button type="button" class="preset" data-field={group.field} data-value={item.value}>
            {item.name}
          </button>
        ))}
      </div>
    ))}
  </form>

  <p id="errors" class="errors no-print" aria-live="polite"></p>
  <p id="summary" class="summary no-print" aria-live="polite"></p>

  <div class="actions no-print">
    <button id="print-btn" type="button">Print</button>
    <a id="open-in-editor" href="/music/abc-editor">Open in ABC editor</a>
  </div>

  <div id="etude-track" class="etude-track"></div>

  <template id="track-template">
    <section class="abc-track">
      <div class="abc-transpose no-print">
        <span class="abc-transpose-label">Transpose</span>
        <button type="button" data-transpose-down aria-label="Transpose down a semitone">&minus;</button>
        <span class="abc-transpose-value" data-transpose-value aria-live="polite" aria-label="Semitones">0</span>
        <button type="button" data-transpose-up aria-label="Transpose up a semitone">+</button>
        <span class="abc-transpose-hint">semitones</span>
      </div>
      <div class="abc-notation-wrap">
        <div class="abc-notation" data-notation></div>
      </div>
      <div class="abc-warnings no-print" data-warnings aria-live="polite"></div>
      <div class="abc-audio no-print" data-audio></div>
      <div class="abc-controls no-print">
        <button type="button" data-download-abc>Download .abc</button>
        <button type="button" data-download-wav>Download WAV</button>
        <button type="button" data-download-midi>Download MIDI</button>
      </div>
      <p class="abc-download-status no-print" data-status aria-live="polite"></p>
    </section>
  </template>
</Layout>

<script>
  import { buildEtude, type EtudeSpec, type ModeSlug } from "../../music/etude-builder/etude.ts";
  import { AbcEditor } from "../../music/abc-editor/abc-editor.ts";

  const form = document.getElementById("builder") as HTMLFormElement;
  const errorsEl = document.getElementById("errors")!;
  const summaryEl = document.getElementById("summary")!;
  const openInEditor = document.getElementById("open-in-editor") as HTMLAnchorElement;

  const field = (id: string) => document.getElementById(id) as HTMLInputElement;
  const select = (id: string) => document.getElementById(id) as HTMLSelectElement;

  // Which control each URL parameter restores into. The builder's state is small and
  // flat, so the query string is the whole store — no localStorage to fall out of sync.
  const PARAMS = ["title", "notes", "rhythm", "bowing", "mode", "meter", "tempo", "length"];

  function readSpec(): EtudeSpec {
    const length = Number(field("length").value);
    return {
      title: field("title").value,
      notes: field("notes").value,
      rhythm: field("rhythm").value,
      bowing: field("bowing").value,
      mode: select("mode").value as ModeSlug,
      meter: select("meter").value,
      tempo: Number(field("tempo").value) || 72,
      length: Number.isFinite(length) && length > 0 ? length : null,
      showBowings: field("show-bowings").checked,
      startUpBow: field("start-up-bow").checked,
    };
  }

  function restoreFromUrl(): void {
    const params = new URLSearchParams(location.search);
    for (const name of PARAMS) {
      const value = params.get(name);
      if (value === null) continue;
      const el = document.getElementById(name) as HTMLInputElement | HTMLSelectElement | null;
      if (el) el.value = value;
    }
    if (params.has("bows")) field("show-bowings").checked = params.get("bows") !== "0";
    if (params.has("up")) field("start-up-bow").checked = params.get("up") === "1";
  }

  function writeUrl(spec: EtudeSpec): void {
    const url = new URL(location.href);
    url.search = "";
    for (const name of PARAMS) {
      const el = document.getElementById(name) as HTMLInputElement | HTMLSelectElement;
      if (el.value) url.searchParams.set(name, el.value);
    }
    if (!spec.showBowings) url.searchParams.set("bows", "0");
    if (spec.startUpBow) url.searchParams.set("up", "1");
    history.replaceState(null, "", url);
  }

  const editor = new AbcEditor({
    container: document.getElementById("etude-track")!,
    template: document.getElementById("track-template") as HTMLTemplateElement,
  });

  function render(): void {
    const spec = readSpec();
    const result = buildEtude(spec);

    errorsEl.textContent = result.errors.join("\n");

    if (result.errors.length > 0) {
      summaryEl.textContent = "";
      return;
    }

    const cycled = result.noteCount >= result.cycle;
    summaryEl.textContent = `${result.noteCount} notes — ${
      cycled ? "one full cycle" : `${result.cycle} would complete the cycle`
    }.`;

    editor.render(result.abc);
    openInEditor.href = `/music/abc-editor?tune=${encodeURIComponent(result.abc)}`;
    writeUrl(spec);
  }

  form.addEventListener("input", render);

  // Presets fill their field's box rather than replacing it: the text stays editable,
  // which is the point of having a box behind the buttons at all.
  for (const button of form.querySelectorAll<HTMLButtonElement>(".preset")) {
    button.addEventListener("click", () => {
      field(button.dataset.field!).value = button.dataset.value!;
      render();
    });
  }

  document.getElementById("print-btn")!.addEventListener("click", () => {
    window.print();
  });

  restoreFromUrl();
  render();
</script>

<style>
  .builder {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }

  .field input,
  .field select {
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  .hint {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .field-small {
    flex: 1 1 7rem;
  }

  .checks {
    gap: 1.25rem;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--text);
  }

  .presets {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .presets-label {
    font-size: 0.85rem;
    color: var(--muted);
    margin-right: 0.2rem;
  }

  .preset {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.85rem;
    cursor: pointer;
  }

  .preset:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .errors {
    min-height: 0;
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: #c0392b;
    white-space: pre-wrap;
  }

  .errors:empty {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    .errors {
      color: #ff8a80;
    }
  }

  .summary {
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .actions button {
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.9rem;
    cursor: pointer;
  }

  .actions button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .etude-track {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 2px solid var(--border);
  }

  .etude-track :global(.abc-track) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .etude-track :global(.abc-notation-wrap) {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    padding: 0.5rem 0.75rem;
  }

  .etude-track :global(.abc-notation) {
    color: var(--text);
    min-width: max-content;
  }

  .etude-track :global(.abc-warnings) {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: #c0392b;
    white-space: pre-wrap;
  }

  @media (prefers-color-scheme: dark) {
    .etude-track :global(.abc-warnings) {
      color: #ff8a80;
    }
  }

  .etude-track :global(.abc-audio) {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .etude-track :global(.abc-transpose) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .etude-track :global(.abc-transpose button) {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  .etude-track :global(.abc-transpose button:hover) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .etude-track :global(.abc-transpose-value) {
    min-width: 2ch;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--text);
  }

  .etude-track :global(.abc-controls) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .etude-track :global(.abc-controls button) {
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.9rem;
    cursor: pointer;
  }

  .etude-track :global(.abc-controls button:hover) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .etude-track :global(.abc-download-status) {
    min-height: 1.2em;
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media print {
    .etude-track {
      margin-top: 0;
      padding-top: 0;
      border-top: none;
    }

    .etude-track :global(.abc-notation-wrap) {
      border: none;
      padding: 0;
      overflow: visible;
    }
  }
</style>
