---
import Layout from "../../layouts/Layout.astro";
import { KEYS, MODES } from "../../music/etudes/scale.ts";
import { INSTRUMENTS } from "../../music/etudes/presets/instruments.ts";
import { PRESET_FAMILIES, familyHref, PRESETS_PATH } from "../../music/etudes/presets/families.ts";
import { notePatternFor } from "../../music/etudes/presets/notes.ts";
import { RHYTHM_NAMES } from "../../music/etudes/presets/rhythms.ts";

// The starting etude: a scale in broken thirds, slurred two at a time, against a rhythm
// that does not divide the pattern — so the default page already shows the point of the
// tool rather than a plain scale.
const DEFAULTS = {
  title: "Etude",
  notes: "1 2 3 4 5 6 7 1'",
  rhythm: "q e e",
  bowing: "2 1 1",
  articulation: "",
  fingering: "",
  mode: "ionian",
  key: "0",
  instrument: "violin",
  octave: "4",
  meter: "4/4",
  tempo: 72,
};

// One field per pattern family, in the order they are read. Each is a named-preset
// picker over a text box: the names are the vocabulary, the box is what keeps any other
// pattern possible.
//
// The fingering is not one of them. A fingering belongs to a note pattern rather than to
// a list of its own, so its picker is filled from whichever pattern is in the notes box
// and is written out separately below.
const FIELDS = PRESET_FAMILIES.filter((family) => family.field !== undefined);

const DEFAULT_FINGERINGS = notePatternFor(DEFAULTS.notes)?.fingerings ?? [];

// The key options are per mode, so the page renders the default mode's and the script
// relabels them when the mode changes. Every mode has the same twelve offsets.
const DEFAULT_KEYS = KEYS[DEFAULTS.mode as keyof typeof KEYS];

const METERS = ["4/4", "3/4", "2/4", "6/8", "5/4"];
---

<Layout
  title="Etude Builder — Nico Bako"
  description="Build your own etude from a note pattern, a rhythm, a bowing and a fingering, in any mode and key, for violin, viola or cello."
>
  <h1 class="no-print">Etude Builder</h1>
  <p class="no-print">
    An etude is a short pattern said several ways at once: which notes, which
    rhythm, which bowing, which fingers. The three time patterns are cycled
    against each other — five notes against a rhythm of three against a bowing of
    two do not repeat for thirty notes — and the tune runs until they line up
    again. Every pattern has <a href={PRESETS_PATH}>named presets</a> behind its
    box, and the URL updates as you type, so a bookmark is an etude.
  </p>

  <form class="builder no-print" id="builder" autocomplete="off">
    {FIELDS.map((family) => (
      <div class="field">
        <div class="field-head">
          <label for={family.field}>{family.name}</label>
          <select class="picker" data-picker-for={family.field} aria-label={`${family.name} presets`}>
            {family.presets.map((preset) => (
              <option value={preset.value}>{preset.name}</option>
            ))}
            <option value="__custom__">Custom…</option>
          </select>
          <a class="about" href={familyHref(family.slug)}>About</a>
        </div>
        <input
          id={family.field}
          name={family.field}
          type="text"
          spellcheck="false"
          value={DEFAULTS[family.field as keyof typeof DEFAULTS]}
        />
        <p class="hint">
          {family.field === "notes" && (
            <>
              Scale degrees <code>1</code>–<code>7</code> of the mode. Add <code>'</code> for an
              octave up and <code>,</code> for an octave down, and <code>#</code> or
              <code>b</code> in front to alter a degree (<code>#7</code> raises the
              seventh of whichever mode is selected, which is what gives harmonic minor
              in Aeolian). Join notes with <code>+</code> for a double stop —
              <code>1+3</code> — which takes one bow and one rhythm value, the same as
              any single note. Which finger plays a note is the fingering's business,
              below.
            </>
          )}
          {family.field === "rhythm" && (
            <>
              {RHYTHM_NAMES.map(([letter, name], i) => (
                <>{i > 0 ? ", " : ""}<code>{letter}</code>{` ${name}`}</>
              ))}. Add a dot for dotted: <code>q.</code>, and a count to repeat
              one: <code>q14 h</code> is fourteen quarter notes and a half. A
              leading <code>3</code> makes a triplet — <code>3e</code> is three
              eighths in the time of two, and counts as three notes against the
              other patterns.
            </>
          )}
          {family.field === "bowing" && (
            <>
              Slur lengths — how many notes go under one bow. <code>2 2 1 1</code> is
              slur two, slur two, then two separate bows. Bow direction just alternates,
              so it is worked out for you rather than typed.
            </>
          )}
          {family.field === "articulation" && (
            <>
              How the bow strokes, which is a separate question from how many notes it
              takes at once. Leave it empty and nothing is marked. One code per note —
              <code>leg</code>, <code>det</code>, <code>ten</code>, <code>acc</code>,
              <code>marc</code>, <code>mart</code>, <code>stac</code>, <code>spic</code>,
              <code>saut</code>, <code>coll</code>, <code>port</code>,
              <code>pizz</code> — each with an optional count, so <code>stac3 mart</code>
              is three staccato then one hammered, cycled against the notes like the
              rhythm and the bowing. <code>pizz</code> drops the bow-direction marks while
              it lasts and writes <em>arco</em> where the bow comes back.
            </>
          )}
        </p>
      </div>
    ))}

    <div class="field">
      <div class="field-head">
        <label for="fingering">Fingering</label>
        <select class="picker" id="fingering-picker" data-picker-for="fingering" aria-label="Fingerings for this note pattern">
          <option value="">Unmarked</option>
          {DEFAULT_FINGERINGS.map((fingering) => (
            <option value={fingering.value}>{fingering.name}</option>
          ))}
          <option value="__custom__">Custom…</option>
        </select>
        <a class="about" href={familyHref("notes")}>About</a>
      </div>
      <input id="fingering" name="fingering" type="text" spellcheck="false" value={DEFAULTS.fingering} />
      <p class="hint">
        One finger per note, <code>0</code>–<code>4</code>, with <code>-</code> to leave a
        note unmarked and <code>+</code> between the fingers of a double stop. A fingering
        marks notes rather than drifting against them, so its length has to divide the note
        pattern's. The named ones are the ways to play <em>this</em> pattern, so the list
        changes with the notes above.
      </p>
    </div>

    <div class="row">
      <div class="field field-small">
        <label for="mode">Mode</label>
        <select id="mode" name="mode">
          {MODES.map((mode) => (
            <option value={mode.slug} selected={mode.slug === DEFAULTS.mode}>{mode.name}</option>
          ))}
        </select>
      </div>

      <div class="field field-small">
        <label for="key">Key</label>
        <select id="key" name="key">
          {DEFAULT_KEYS.map((key) => (
            <option value={String(key.offset)} selected={String(key.offset) === DEFAULTS.key}>
              {key.label}
            </option>
          ))}
        </select>
      </div>

      <div class="field field-small">
        <label for="instrument">Instrument</label>
        <select id="instrument" name="instrument">
          {INSTRUMENTS.map((instrument) => (
            <option
              value={instrument.slug}
              data-octave={instrument.rootOctave}
              selected={instrument.slug === DEFAULTS.instrument}
            >
              {instrument.name}
            </option>
          ))}
        </select>
      </div>

      <div class="field field-small">
        <label for="octave">Root octave</label>
        <input id="octave" name="octave" type="number" min="1" max="6" value={DEFAULTS.octave} />
      </div>

      <div class="field field-small">
        <label for="meter">Meter</label>
        <select id="meter" name="meter">
          {METERS.map((meter) => (
            <option value={meter} selected={meter === DEFAULTS.meter}>{meter}</option>
          ))}
        </select>
      </div>

      <div class="field field-small">
        <label for="tempo">Tempo</label>
        <input id="tempo" name="tempo" type="number" min="30" max="208" value={DEFAULTS.tempo} />
      </div>

      <div class="field field-small">
        <label for="length">Length</label>
        <input id="length" name="length" type="number" min="1" max="192" placeholder="auto" />
      </div>

      <div class="field field-small">
        <label for="title">Title</label>
        <input id="title" name="title" type="text" value={DEFAULTS.title} />
      </div>
    </div>

    <div class="row checks">
      <label class="check"><input id="show-bowings" type="checkbox" checked /> Mark bow directions</label>
      <label class="check"><input id="start-up-bow" type="checkbox" /> Start up-bow</label>
    </div>
  </form>

  <p id="errors" class="errors no-print" aria-live="polite"></p>
  <p id="summary" class="summary no-print" aria-live="polite"></p>

  <div class="actions no-print">
    <a id="open-in-editor" href="/music/abc-editor">Open in ABC editor</a>
  </div>

  <div id="etude-track" class="etude-track"></div>

  <template id="track-template">
    <section class="abc-track">
      <div class="abc-notation-wrap">
        <div class="abc-notation" data-notation></div>
      </div>
      <div class="abc-warnings no-print" data-warnings aria-live="polite"></div>
      <div class="abc-audio no-print" data-audio></div>
      <div class="abc-controls no-print">
        <button type="button" data-download-abc>Download .abc</button>
        <button type="button" data-download-wav>Download WAV</button>
        <button type="button" data-download-midi>Download MIDI</button>
      </div>
      <p class="abc-download-status no-print" data-status aria-live="polite"></p>
    </section>
  </template>
</Layout>

<script>
  import { buildEtude, describeEtude, defineEtude, type Etude } from "../../music/etudes/etude.ts";
  import { KEYS, type ModeSlug } from "../../music/etudes/scale.ts";
  import { instrumentFor } from "../../music/etudes/presets/instruments.ts";
  import { notePatternFor } from "../../music/etudes/presets/notes.ts";
  import { AbcEditor } from "../../music/abc-editor/abc-editor.ts";

  const form = document.getElementById("builder") as HTMLFormElement;
  const errorsEl = document.getElementById("errors")!;
  const summaryEl = document.getElementById("summary")!;
  const openInEditor = document.getElementById("open-in-editor") as HTMLAnchorElement;

  /** The picker option that means "whatever is in the box". */
  const CUSTOM = "__custom__";

  const field = (id: string) => document.getElementById(id) as HTMLInputElement;
  const select = (id: string) => document.getElementById(id) as HTMLSelectElement;

  // Which control each URL parameter restores into. The builder's state is small and
  // flat, so the query string is the whole store — no localStorage to fall out of sync.
  const PARAMS = [
    "title", "notes", "rhythm", "bowing", "articulation", "fingering",
    "mode", "key", "instrument", "octave", "meter", "tempo", "length",
  ];

  function readEtude(): Etude {
    const length = Number(field("length").value);
    const mode = select("mode").value as ModeSlug;
    // The clef is the instrument's; nothing else about the instrument reaches the
    // generator, because the register is the root octave and that is set on its own.
    return defineEtude({
      title: field("title").value,
      notes: field("notes").value,
      rhythm: field("rhythm").value,
      bowing: field("bowing").value,
      articulation: field("articulation").value,
      fingering: field("fingering").value,
      mode,
      keyOffset: Number(select("key").value) || 0,
      clef: instrumentFor(select("instrument").value).clef,
      rootOctave: Number(field("octave").value) || 4,
      meter: select("meter").value,
      tempo: Number(field("tempo").value) || 72,
      length: Number.isFinite(length) && length > 0 ? length : null,
      showBowings: field("show-bowings").checked,
      startUpBow: field("start-up-bow").checked,
    });
  }

  /** The twelve keys are per mode, so their labels are rewritten when the mode changes. */
  function relabelKeys(): void {
    const keys = KEYS[select("mode").value as ModeSlug];
    const chosen = select("key").value;
    for (const [i, option] of [...select("key").options].entries()) {
      const key = keys[i];
      if (!key) continue;
      option.value = String(key.offset);
      option.textContent = key.label;
    }
    select("key").value = chosen;
  }

  /**
   * Refill the fingering picker from the note pattern now in the notes box.
   *
   * A fingering belongs to a pattern, so the named ones are whatever that pattern
   * carries — and a typed pattern simply has none to offer. Built with
   * `createElement` rather than assembled as markup.
   */
  function refreshFingerings(): void {
    const picker = select("fingering-picker");
    const fingerings = notePatternFor(field("notes").value)?.fingerings ?? [];

    picker.textContent = "";
    for (const [value, label] of [
      ["", "Unmarked"],
      ...fingerings.map((fingering) => [fingering.value, fingering.name] as const),
      [CUSTOM, "Custom…"],
    ] as [string, string][]) {
      const option = document.createElement("option");
      option.value = value;
      option.textContent = label;
      picker.appendChild(option);
    }
  }

  /**
   * Point each preset picker at the pattern now in its box, falling back to Custom.
   * A `<select>` whose value matches no option selects nothing, so the empty-valued
   * Custom option is what catches a typed pattern.
   */
  function syncPickers(): void {
    for (const picker of form.querySelectorAll<HTMLSelectElement>(".picker")) {
      const value = field(picker.dataset.pickerFor!).value.trim().split(/\s+/).join(" ");
      const known = [...picker.options].some((option) => option.value === value);
      picker.value = known ? value : CUSTOM;
    }
  }

  function restoreFromUrl(): void {
    const params = new URLSearchParams(location.search);

    // Modes used to be parallel — major and minor on one tonic — and are now rotations
    // of one parent scale. Aeolian *is* natural minor, so an old link keeps its sound:
    // written on A at root 3 and transposed up a minor third, the tonic lands on the
    // same C it always did. Only applied when the link carries no key of its own.
    const legacy = params.get("mode");
    if ((legacy === "major" || legacy === "minor") && !params.has("key")) {
      params.set("mode", legacy === "major" ? "ionian" : "aeolian");
      params.set("key", legacy === "major" ? "0" : "3");
      params.set("octave", legacy === "major" ? "4" : "3");
    }

    if (params.has("mode")) select("mode").value = params.get("mode")!;
    relabelKeys();

    for (const name of PARAMS) {
      const value = params.get(name);
      if (value === null) continue;
      const el = document.getElementById(name) as HTMLInputElement | HTMLSelectElement | null;
      if (el) el.value = value;
    }
    refreshFingerings();
    if (params.has("bows")) field("show-bowings").checked = params.get("bows") !== "0";
    if (params.has("up")) field("start-up-bow").checked = params.get("up") === "1";
    syncPickers();
  }

  function writeUrl(etude: Etude): void {
    const url = new URL(location.href);
    url.search = "";
    for (const name of PARAMS) {
      const el = document.getElementById(name) as HTMLInputElement | HTMLSelectElement;
      if (el.value) url.searchParams.set(name, el.value);
    }
    if (!etude.showBowings) url.searchParams.set("bows", "0");
    if (etude.startUpBow) url.searchParams.set("up", "1");
    history.replaceState(null, "", url);
  }

  const editor = new AbcEditor({
    container: document.getElementById("etude-track")!,
    template: document.getElementById("track-template") as HTMLTemplateElement,
  });

  function render(): void {
    const etude = readEtude();
    const result = buildEtude(etude);

    errorsEl.textContent = result.errors.join("\n");

    if (result.errors.length > 0) {
      summaryEl.textContent = "";
      return;
    }

    const cycled = result.noteCount >= result.cycle;
    summaryEl.textContent = `${describeEtude(etude)} ${result.noteCount} notes — ${
      cycled ? "one full cycle" : `${result.cycle} would complete the cycle`
    }.`;

    // The key is a transposition rather than something written into the source, so it
    // reaches the track as its base offset.
    editor.render(result.abc, result.transposition);
    openInEditor.href = `/music/abc-editor?tune=${encodeURIComponent(result.abc)}&transpose=${result.transposition}`;
    writeUrl(etude);
  }

  form.addEventListener("input", (event) => {
    // A `<select>` fires `input` before `change`, so re-syncing the pickers here would
    // point one back at the box's old contents before its own handler had filled it.
    const target = event.target as HTMLElement;
    // A new note pattern brings its own fingerings, so the picker is rebuilt before the
    // pickers are re-synced against what is in the boxes.
    if (target.id === "notes") refreshFingerings();
    if (!target.classList.contains("picker")) syncPickers();
    render();
  });

  // A picker fills its field's box rather than replacing it: the text stays editable,
  // which is the point of having a box behind the names at all. Custom fills nothing.
  for (const picker of form.querySelectorAll<HTMLSelectElement>(".picker")) {
    picker.addEventListener("change", () => {
      if (picker.value === CUSTOM) return;
      field(picker.dataset.pickerFor!).value = picker.value;
      // Changing the notes changes which fingerings exist; the one in the box may not be
      // among them any more, which `syncPickers` then reports as Custom.
      if (picker.dataset.pickerFor === "notes") {
        refreshFingerings();
        syncPickers();
      }
      render();
    });
  }

  // An instrument is a clef and a sensible register; the register stays editable after.
  select("instrument").addEventListener("change", () => {
    const octave = select("instrument").selectedOptions[0]?.dataset.octave;
    if (octave) field("octave").value = octave;
    render();
  });

  select("mode").addEventListener("change", () => {
    relabelKeys();
    render();
  });

  restoreFromUrl();
  render();
</script>

<style>
  .builder {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }

  .field input,
  .field select {
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  .hint {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .field-small {
    flex: 1 1 7rem;
  }

  .checks {
    gap: 1.25rem;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--text);
  }

  /* The label, its preset picker and the link to what the presets mean, on one line. */
  .field-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .field-head label {
    flex: 0 0 auto;
  }

  .picker {
    flex: 0 1 14rem;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.85rem;
  }

  .about {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .errors {
    min-height: 0;
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: #c0392b;
    white-space: pre-wrap;
  }

  .errors:empty {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    .errors {
      color: #ff8a80;
    }
  }

  .summary {
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .etude-track {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 2px solid var(--border);
  }

  .etude-track :global(.abc-track) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .etude-track :global(.abc-notation-wrap) {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    padding: 0.5rem 0.75rem;
  }

  .etude-track :global(.abc-notation) {
    color: var(--text);
    min-width: max-content;
  }

  .etude-track :global(.abc-warnings) {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: #c0392b;
    white-space: pre-wrap;
  }

  @media (prefers-color-scheme: dark) {
    .etude-track :global(.abc-warnings) {
      color: #ff8a80;
    }
  }

  .etude-track :global(.abc-audio) {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .etude-track :global(.abc-controls) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .etude-track :global(.abc-controls button) {
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.9rem;
    cursor: pointer;
  }

  .etude-track :global(.abc-controls button:hover) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .etude-track :global(.abc-download-status) {
    min-height: 1.2em;
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media print {
    .etude-track {
      margin-top: 0;
      padding-top: 0;
      border-top: none;
    }

    .etude-track :global(.abc-notation-wrap) {
      border: none;
      padding: 0;
      overflow: visible;
    }
  }
</style>
