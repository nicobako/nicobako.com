---
import Layout from "../layouts/Layout.astro";
import LinkList from "../components/LinkList.astro";
import { SECTIONS } from "../site/navigation.ts";
---

<Layout>
  <section class="intro">
    <h1>Nico Bako</h1>
    <p class="role">Lifelong Learner</p>
    <p>
      Welcome to Nico's digital cornucopia, where, with the help of my
      childrens' imagination, and AI's typing speed, I create and share a
      variety of digital curiosities.
    </p>
    <p>Please explore and enjoy the content.</p>
  </section>

  <h2 id="around">Around the site</h2>
  {/*
    This list is the only way into the site — the header carries no section
    links — so it gets the same row treatment as every section index's list.
  */}
  <LinkList links={SECTIONS} labelledby="around" />
</Layout>

<style>
  .intro p {
    color: var(--muted);
    max-width: 46ch;
  }

  .role {
    font-weight: 600;
    color: var(--text);
    margin-bottom: 1rem;
  }

</style>
