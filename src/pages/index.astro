---
import Layout from "../layouts/Layout.astro";
import { publishedPosts, formatDate, isoDate } from "../blog/blog.ts";
import { SECTIONS } from "../site/navigation.ts";

// The three newest posts. The section disappears entirely when there are none,
// so the home page never advertises an empty blog.
const latestPosts = (await publishedPosts()).slice(0, 3);

const stack = [
  "Python",
  "Django",
  "FastAPI",
  "SQL",
  "Docker",
  "TypeScript",
  "Git",
];
---

<Layout>
  <section class="intro">
    <h1>Hi, I'm Nico Bako.</h1>
    <p class="role">Lifelong Learner and Amateur</p>
    <p>
      Welcome to Nico's digital cornucopia, where, with the help of my
      childrens' imagination, and AI's typing speed, I create and share a
      variety of digital curiosities.
    </p>
  </section>

  <h2>Around the site</h2>
  <div class="sections">
    {SECTIONS.map((section) => (
      <article>
        <h3>
          <a href={section.href}>{section.label}</a>
        </h3>
        <p>{section.blurb}</p>
      </article>
    ))}
  </div>

  {latestPosts.length > 0 && (
    <>
      <h2>Latest writing</h2>
      <ul class="posts">
        {latestPosts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <p class="post-meta">
              <time datetime={isoDate(post.data.date)}>
                {formatDate(post.data.date)}
              </time>
            </p>
          </li>
        ))}
      </ul>
      <p>
        <a href="/blog/">All posts →</a>
      </p>
    </>
  )}

  <h2>Tools I reach for</h2>
  <ul class="stack">
    {stack.map((tech) => (
      <li>{tech}</li>
    ))}
  </ul>
</Layout>

<style>
  /* One card per section — the way into the site now that the header has no
     dropdown. Plain bordered cards, no shadows or motion; the whole
     card is clickable, with the heading's link as the accessible target. */
  .sections {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }

  .sections article {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem;
    transition: border-color 0.12s;
  }

  .sections article:hover {
    border-color: var(--accent);
  }

  .sections h3 {
    margin-top: 0;
  }

  .sections h3 a {
    text-decoration: none;
  }

  /* The heading's link covers the card, so the whole card is the target
     without nesting the paragraph inside an <a>. */
  .sections h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 10px;
  }

  .sections p {
    margin-bottom: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .posts {
    list-style: none;
    padding: 0;
  }

  .posts > li + li {
    margin-top: 1rem;
  }

  .posts a {
    font-weight: 600;
    text-decoration: none;
  }

  .posts a:hover {
    text-decoration: underline;
  }

  .post-meta {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .intro p {
    color: var(--muted);
    max-width: 46ch;
  }

  .role {
    font-weight: 600;
    color: var(--text);
    margin-bottom: 1rem;
  }

  /* Stack: list rendered as inline pills. */
  .stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
  }

  .stack li {
    margin-top: 0;
    font-size: 0.9rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
  }

  .game {
    display: block;
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem;
  }

  .game:hover {
    border-color: var(--accent);
  }

  .game strong {
    display: block;
    margin-bottom: 0.25rem;
  }

  .game span {
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
